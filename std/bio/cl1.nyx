module std.bio.cl1

pub struct ClSpikeFrame {
    pub timestamp_micros: i64,
    pub channel_id: i64,
    pub amplitude_microvolts: f64,
    pub is_verified: bool
}

pub struct StimDesign {
    pub target_channel: i64,
    pub amplitude_mv: f64,
    pub pulse_duration_micros: i64
}

pub struct BurstDesign {
    pub start_channel: i64,
    pub channel_count: i64,
    pub frequency_hz: f64,
    pub burst_duration_ms: i64
}

impl ClSpikeFrame {
    pub fn new(chan: i64, amp: f64) -> ClSpikeFrame {
        ClSpikeFrame {
            timestamp_micros: 0,
            channel_id: chan,
            amplitude_microvolts: amp,
            is_verified: true
        }
    }

    pub fn validate_biological_bounds(self: &ClSpikeFrame) -> bool {
        if self.amplitude_microvolts < 5000.0 {
            true
        } else {
            false
        }
    }
}
