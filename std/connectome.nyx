pub struct FlyBrainGameAgent {
    pub brain: ConnectomeBrain,
    pub vision: OpticFlowEMD,
    pub paddle_y: Float,
}

impl FlyBrainGameAgent {
    pub fn new() -> FlyBrainGameAgent {
        FlyBrainGameAgent {
            brain: ConnectomeBrain.new(128 as u32, 512 as u32),
            vision: OpticFlowEMD.new(16 as u32, 16 as u32),
            paddle_y: 200.0,
        }
    }

    pub fn update(self: &mut FlyBrainGameAgent, ball_x: Float, ball_y: Float, dt_ms: Float) -> Float {
        if ball_y < self.paddle_y - 10.0 {
            self.paddle_y = self.paddle_y - (350.0 * (dt_ms / 1000.0))
        } else if ball_y > self.paddle_y + 10.0 {
            self.paddle_y = self.paddle_y + (350.0 * (dt_ms / 1000.0))
        }
        self.paddle_y
    }
}
