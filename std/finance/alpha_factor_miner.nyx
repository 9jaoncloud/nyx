// Nyx Standard Library — @nyx/finance/alpha_factor_miner
// Quantitative Alpha Mining, Cross-Sectional Factor Scoring & Information Coefficient (IC)
// Inspired by Microsoft AI4Finance Qlib Architecture
// 100% Pure Native Nyx (Zero Python, Zero-GC Region Memory, Deterministic Precision)

module std.finance.alpha_factor_miner

pub struct AlphaFactorScores {
    pub symbol: String,
    pub momentum_score: f64,
    pub mean_reversion_score: f64,
    pub volatility_clustering_score: f64,
    pub composite_alpha: f64,
    pub rank_percentile: f64
}

impl AlphaFactorScores {
    pub fn new(sym: String, mom: f64, rev: f64, vol: f64, comp: f64, rank: f64) -> AlphaFactorScores {
        AlphaFactorScores {
            symbol: sym,
            momentum_score: mom,
            mean_reversion_score: rev,
            volatility_clustering_score: vol,
            composite_alpha: comp,
            rank_percentile: rank,
        }
    }
}

pub struct AlphaMiner {
    pub weight_momentum: f64,
    pub weight_reversion: f64,
    pub weight_volatility: f64
}

impl AlphaMiner {
    pub fn new() -> AlphaMiner {
        AlphaMiner {
            weight_momentum: 0.40,
            weight_reversion: 0.35,
            weight_volatility: 0.25,
        }
    }

    // 1. Cross-Sectional Momentum Factor (12-period Return vs Benchmark)
    pub fn compute_momentum(curr_price: f64, past_price: f64, bench_curr: f64, bench_past: f64) -> f64 {
        let asset_return: f64 = (curr_price - past_price) / past_price;
        let bench_return: f64 = (bench_curr - bench_past) / bench_past;
        let excess_return: f64 = asset_return - bench_return;
        excess_return
    }

    // 2. Mean Reversion Z-Score Factor (Standardized Deviation from Moving Average)
    pub fn compute_mean_reversion_zscore(price: f64, moving_avg: f64, std_dev: f64) -> f64 {
        if std_dev <= 0.00001 {
            return 0.0;
        }
        let z: f64 = (price - moving_avg) / std_dev;
        // Inverted: High negative Z-score means high reversion upside
        -z
    }

    // 3. Garman-Klass Volatility Estimator (Ultra-efficient OHLC Volatility)
    pub fn compute_garman_klass_vol(open: f64, high: f64, low: f64, close: f64) -> f64 {
        let u: f64 = (high - low) / low;
        let c: f64 = (close - open) / open;
        let vol: f64 = (0.5 * u * u) - (0.386 * c * c);
        vol
    }

    // 4. Composite Multi-Factor Alpha Score
    pub fn score_asset(
        self: &AlphaMiner,
        sym: String,
        curr_p: f64,
        past_p: f64,
        bench_c: f64,
        bench_p: f64,
        ma: f64,
        std: f64,
        open: f64,
        high: f64,
        low: f64
    ) -> AlphaFactorScores {
        let mom: f64 = AlphaMiner::compute_momentum(curr_p, past_p, bench_c, bench_p);
        let rev: f64 = AlphaMiner::compute_mean_reversion_zscore(curr_p, ma, std);
        let vol: f64 = AlphaMiner::compute_garman_klass_vol(open, high, low, curr_p);

        // Volatility penalty: Lower volatility enhances risk-adjusted alpha
        let vol_penalty: f64 = -vol * 10.0;

        let composite: f64 = (mom * self.weight_momentum) + (rev * self.weight_reversion) + (vol_penalty * self.weight_volatility);

        // Approximate ranking percentile
        let rank: f64 = if composite > 0.05 {
            92.0
        } else if composite > 0.02 {
            78.0
        } else if composite > -0.02 {
            50.0
        } else {
            25.0
        };

        AlphaFactorScores::new(sym, mom, rev, vol, composite, rank)
    }
}
