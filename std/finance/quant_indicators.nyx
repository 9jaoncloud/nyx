// Nyx Standard Library — @nyx/finance/quant_indicators
// Zero-GC Algorithmic Trading Indicators & Quantitative Signal Processors
// Pure Native Nyx (No Python, Zero Runtime Pauses)

module std.finance.quant_indicators

pub struct CandleBar {
    pub open: f64,
    pub high: f64,
    pub low: f64,
    pub close: f64,
    pub volume: f64
}

impl CandleBar {
    pub fn new(o: f64, h: f64, l: f64, c: f64, v: f64) -> CandleBar {
        CandleBar {
            open: o,
            high: h,
            low: l,
            close: c,
            volume: v,
        }
    }
}

pub struct QuantSignal {
    pub indicator_name: String,
    pub action: String, // "BUY", "SELL", "HOLD"
    pub price: f64,
    pub stop_loss: f64,
    pub take_profit: f64,
    pub score: f64
}

impl QuantSignal {
    pub fn hold(name: String) -> QuantSignal {
        QuantSignal {
            indicator_name: name,
            action: "HOLD",
            price: 0.0,
            stop_loss: 0.0,
            take_profit: 0.0,
            score: 0.0,
        }
    }

    pub fn trigger(name: String, act: String, p: f64, sl: f64, tp: f64, s: f64) -> QuantSignal {
        QuantSignal {
            indicator_name: name,
            action: act,
            price: p,
            stop_loss: sl,
            take_profit: tp,
            score: s,
        }
    }
}

// -----------------------------------------------------------------------------
// 1. Trend Rider v3 Funnel (Fast 4, Med 6, Slow 14 + Breakout Buffer)
// -----------------------------------------------------------------------------
pub struct TrendRiderIndicator {
    pub breakout_buffer: f64
}

impl TrendRiderIndicator {
    pub fn new(buffer: f64) -> TrendRiderIndicator {
        TrendRiderIndicator { breakout_buffer: buffer }
    }

    pub fn compute_signal(self: &TrendRiderIndicator, fast_ema: f64, med_ema: f64, slow_ema: f64, close: f64, prev_high: f64, prev_low: f64, atr: f64) -> QuantSignal {
        let is_bull: bool = (fast_ema > med_ema) && (med_ema > slow_ema);
        let is_bear: bool = (fast_ema < med_ema) && (med_ema < slow_ema);

        if (is_bull == true) && (close > (prev_high + self.breakout_buffer)) {
            let sl: f64 = slow_ema - (atr * 0.8);
            let tp: f64 = close + ((close - sl) * 2.0);
            return QuantSignal::trigger("TrendRiderV3", "BUY", close, sl, tp, 0.88);
        }

        if (is_bear == true) && (close < (prev_low - self.breakout_buffer)) {
            let sl: f64 = slow_ema + (atr * 0.8);
            let tp: f64 = close - ((sl - close) * 2.0);
            return QuantSignal::trigger("TrendRiderV3", "SELL", close, sl, tp, 0.88);
        }

        QuantSignal::hold("TrendRiderV3")
    }
}

// -----------------------------------------------------------------------------
// 2. Woodies CCI Pro (CCI 14 + Zero-Line Reject)
// -----------------------------------------------------------------------------
pub struct WoodiesCCIIndicator {
    pub boundary: f64
}

impl WoodiesCCIIndicator {
    pub fn new() -> WoodiesCCIIndicator {
        WoodiesCCIIndicator { boundary: 100.0 }
    }

    pub fn compute_zlr(self: &WoodiesCCIIndicator, cci_curr: f64, cci_prev: f64, bars_above: i64, bars_below: i64, price: f64, atr: f64) -> QuantSignal {
        if bars_above >= 6 {
            let was_pulling: bool = (cci_prev < self.boundary) && (cci_prev > -50.0);
            let hooked_up: bool = cci_curr > cci_prev;
            if (was_pulling == true) && (hooked_up == true) {
                return QuantSignal::trigger("WoodiesZLR", "BUY", price, price - (atr * 1.5), price + (atr * 2.5), 0.85);
            }
        }

        if bars_below >= 6 {
            let was_rallying: bool = (cci_prev > -self.boundary) && (cci_prev < 50.0);
            let hooked_down: bool = cci_curr < cci_prev;
            if (was_rallying == true) && (hooked_down == true) {
                return QuantSignal::trigger("WoodiesZLR", "SELL", price, price + (atr * 1.5), price - (atr * 2.5), 0.85);
            }
        }

        QuantSignal::hold("WoodiesZLR")
    }
}

// -----------------------------------------------------------------------------
// 3. Fibonacci Golden Zone (0.50 - 0.618 Pocket)
// -----------------------------------------------------------------------------
pub struct FibGoldenIndicator {
    pub ratio_50: f64,
    pub ratio_618: f64
}

impl FibGoldenIndicator {
    pub fn new() -> FibGoldenIndicator {
        FibGoldenIndicator { ratio_50: 0.50, ratio_618: 0.618 }
    }

    pub fn compute_pocket(self: &FibGoldenIndicator, swing_high: f64, swing_low: f64, price: f64, prior_close: f64, is_uptrend: bool) -> QuantSignal {
        let span: f64 = swing_high - swing_low;
        if span <= 0.00001 {
            return QuantSignal::hold("FibGoldenZone");
        }

        if is_uptrend == true {
            let f50: f64 = swing_high - (span * self.ratio_50);
            let f618: f64 = swing_high - (span * self.ratio_618);
            if (price <= f50) && (price >= f618) && (price > prior_close) {
                let sl: f64 = swing_low;
                let tp: f64 = swing_high + (span * 0.618);
                return QuantSignal::trigger("FibGoldenZone", "BUY", price, sl, tp, 0.90);
            }
        } else {
            let f50: f64 = swing_low + (span * self.ratio_50);
            let f618: f64 = swing_low + (span * self.ratio_618);
            if (price >= f50) && (price <= f618) && (price < prior_close) {
                let sl: f64 = swing_high;
                let tp: f64 = swing_low - (span * 0.618);
                return QuantSignal::trigger("FibGoldenZone", "SELL", price, sl, tp, 0.90);
            }
        }

        QuantSignal::hold("FibGoldenZone")
    }
}
