// std/finance/impulse_volume_atlas.nyx
// Sovereign Market Microstructure & Kinetic Order-Flow Engine
// Synthesizes:
// 1. Momentum Impulse Follow-Through Vector (Pineify / Pine Script v6)
// 2. Intra-Bar Shortest-Path Volume Pressure Atlas (MQLSoftware)
// 3. Matrix Reinforcement Learning State Evaluator (Q-Matrix / MQL5 20322)
// Zero-GC Region Allocated | Freestanding Nyx / Sophia Cortex Native

module std.finance.impulse_volume_atlas

struct CandleBar {
    open: f64,
    high: f64,
    low: f64,
    close: f64,
    volume: f64
}

struct VolumePressureAtlas {
    matched_core_volume: f64,
    unmatched_bull_volume: f64,
    unmatched_bear_volume: f64,
    net_aggression_ratio: f64
}

struct ImpulsePathMap {
    residual_impulse: f64,
    follow_through_score: f64,
    is_confirmed_breakout: bool,
    exhaustion_risk_pct: f64
}

struct QMatrixState {
    regime_id: int, // 0=Compression, 1=ImpulseUp, 2=ImpulseDown, 3=Exhaustion
    optimal_action: int, // 0=Hold/Cash, 1=PyramidLong, 2=PyramidShort
    confidence_q: f64
}

impl VolumePressureAtlas {
    // Computes intra-bar shortest path allocation:
    // Bullish bar path: Open -> Low -> High -> Close
    // Bearish bar path: Open -> High -> Low -> Close
    fn calculate(bar: CandleBar) -> VolumePressureAtlas {
        let total_vol = bar.volume
        let range = bar.high - bar.low
        if range <= 0.000001 {
            return VolumePressureAtlas {
                matched_core_volume: total_vol,
                unmatched_bull_volume: 0.0,
                unmatched_bear_volume: 0.0,
                net_aggression_ratio: 0.0
            }
        }

        let body = bar.close - bar.open
        let is_bullish = body >= 0.0

        let mut bull_dist = 0.0
        let mut bear_dist = 0.0

        if is_bullish {
            // Path: O -> L (down), L -> H (up), H -> C (down)
            let d1 = bar.open - bar.low
            let d2 = bar.high - bar.low
            let d3 = bar.high - bar.close
            bull_dist = d2
            bear_dist = d1 + d3
        } else {
            // Path: O -> H (up), H -> L (down), L -> C (up)
            let d1 = bar.high - bar.open
            let d2 = bar.high - bar.low
            let d3 = bar.close - bar.low
            bull_dist = d1 + d3
            bear_dist = d2
        }

        let total_dist = bull_dist + bear_dist
        if total_dist <= 0.000001 {
            return VolumePressureAtlas {
                matched_core_volume: total_vol,
                unmatched_bull_volume: 0.0,
                unmatched_bear_volume: 0.0,
                net_aggression_ratio: 0.0
            }
        }

        let bull_vol_share = total_vol * (bull_dist / total_dist)
        let bear_vol_share = total_vol * (bear_dist / total_dist)

        let matched = if bull_vol_share < bear_vol_share { bull_vol_share * 2.0 } else { bear_vol_share * 2.0 }
        let unmatched_bull = if bull_vol_share > bear_vol_share { bull_vol_share - bear_vol_share } else { 0.0 }
        let unmatched_bear = if bear_vol_share > bull_vol_share { bear_vol_share - bull_vol_share } else { 0.0 }
        let net_ratio = (bull_vol_share - bear_vol_share) / total_vol

        return VolumePressureAtlas {
            matched_core_volume: matched,
            unmatched_bull_volume: unmatched_bull,
            unmatched_bear_volume: unmatched_bear,
            net_aggression_ratio: net_ratio
        }
    }
}

impl ImpulsePathMap {
    fn evaluate(bar: CandleBar, baseline_atr: f64, lookback_bars: int) -> ImpulsePathMap {
        let bar_range = bar.high - bar.low
        let robust_scale = if baseline_atr > 0.0001 { baseline_atr } else { 1.0 }
        let move_scale = bar_range / robust_scale
        let residual = (bar.close - bar.open) / robust_scale

        let is_impulse = move_scale >= 2.0
        let is_confirmed = is_impulse && (residual > 1.5 || residual < -1.5)
        let follow_through = if is_confirmed { (bar.volume / 1000.0) * residual } else { 0.0 }
        let exhaustion_pct = if move_scale > 4.0 { 75.0 } else { 20.0 }

        return ImpulsePathMap {
            residual_impulse: residual,
            follow_through_score: follow_through,
            is_confirmed_breakout: is_confirmed,
            exhaustion_risk_pct: exhaustion_pct
        }
    }
}

impl QMatrixState {
    // Q-Learning policy evaluation based on MQL5 Article 20322 matrix mechanics
    fn evaluate_state(atlas: VolumePressureAtlas, impulse: ImpulsePathMap) -> QMatrixState {
        let mut regime = 0
        let mut action = 0
        let mut confidence = 0.50

        if impulse.is_confirmed_breakout && atlas.net_aggression_ratio > 0.35 {
            regime = 1 // Impulse Up
            action = 1 // Pyramid Long
            confidence = 0.88
        } else if impulse.is_confirmed_breakout && atlas.net_aggression_ratio < -0.35 {
            regime = 2 // Impulse Down
            action = 2 // Pyramid Short
            confidence = 0.88
        } else if impulse.exhaustion_risk_pct > 65.0 {
            regime = 3 // Exhaustion
            action = 0 // Hold / Cash
            confidence = 0.92
        } else {
            regime = 0 // Compression / Neutral
            action = 0 // Standby
            confidence = 0.65
        }

        return QMatrixState {
            regime_id: regime,
            optimal_action: action,
            confidence_q: confidence
        }
    }
}

