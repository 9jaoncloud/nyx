// Nyx Standard Library — @nyx/finance/reinforcement_policy
// Financial Reinforcement Learning (FRL) Policy Engine & Zero-GC Reward Optimizer
// Inspired by AI4Finance FinRL / FinRobot Architectures
// 100% Pure Native Nyx (Zero Python, Zero PyTorch, Zero Runtime Allocations)

module std.finance.reinforcement_policy

pub struct StateVector {
    pub norm_price_return: f64,
    pub norm_rsi: f64,
    pub norm_volatility: f64,
    pub portfolio_cash_ratio: f64,
    pub active_position_ratio: f64
}

impl StateVector {
    pub fn new(ret: f64, rsi: f64, vol: f64, cash: f64, pos: f64) -> StateVector {
        StateVector {
            norm_price_return: ret,
            norm_rsi: (rsi - 50.0) / 50.0, // Scaled -1.0 to +1.0
            norm_volatility: vol,
            portfolio_cash_ratio: cash,
            active_position_ratio: pos,
        }
    }
}

pub struct RLPolicyDecision {
    pub action_target_exposure: f64, // Continuous action: -1.0 (100% Short) to +1.0 (100% Long)
    pub expected_q_value: f64,
    pub policy_confidence: f64,
    pub reward_signal: f64
}

impl RLPolicyDecision {
    pub fn new(exp: f64, q: f64, conf: f64, rew: f64) -> RLPolicyDecision {
        RLPolicyDecision {
            action_target_exposure: exp,
            expected_q_value: q,
            policy_confidence: conf,
            reward_signal: rew,
        }
    }
}

// Actor-Critic Continuous Policy Network (Zero-GC Fixed Weight Inference)
pub struct FinancialRLPolicy {
    pub learning_rate: f64,
    pub discount_factor_gamma: f64,
    // Linear Value Function Weights
    pub w_return: f64,
    pub w_rsi: f64,
    pub w_vol: f64,
    pub w_cash: f64,
    pub w_pos: f64
}

impl FinancialRLPolicy {
    pub fn new() -> FinancialRLPolicy {
        FinancialRLPolicy {
            learning_rate: 0.001,
            discount_factor_gamma: 0.99,
            w_return: 0.45,
            w_rsi: -0.35, // Mean-reversion bias
            w_vol: -0.20, // Risk penalty
            w_cash: 0.15,
            w_pos: -0.10,
        }
    }

    // Evaluates Value Function Q(s, a)
    pub fn evaluate_state_value(self: &FinancialRLPolicy, s: &StateVector) -> f64 {
        let q: f64 = (s.norm_price_return * self.w_return)
            + (s.norm_rsi * self.w_rsi)
            + (s.norm_volatility * self.w_vol)
            + (s.portfolio_cash_ratio * self.w_cash)
            + (s.active_position_ratio * self.w_pos);
        q
    }

    // Policy Step: Computes optimal target exposure using hyperbolic tangent activation
    pub fn act(self: &FinancialRLPolicy, s: &StateVector) -> RLPolicyDecision {
        let q: f64 = self.evaluate_state_value(s);

        // Clamped continuous action [-1.0, 1.0]
        let action: f64 = if q > 1.0 {
            1.0
        } else if q < -1.0 {
            -1.0
        } else {
            q
        };

        let conf: f64 = if action >= 0.0 { action } else { -action };

        RLPolicyDecision::new(action, q, conf, 0.0)
    }

    // Differential Sharpe Ratio Reward step
    pub fn compute_reward(realized_return: f64, portfolio_volatility: f64, drawdown_penalty: f64) -> f64 {
        if portfolio_volatility <= 0.0001 {
            return realized_return;
        }
        let sharpe_component: f64 = realized_return / portfolio_volatility;
        let final_reward: f64 = sharpe_component - (drawdown_penalty * 2.0);
        final_reward
    }
}
