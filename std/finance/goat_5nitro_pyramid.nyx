module std.finance.goat_5nitro_pyramid;

// ============================================================================
// NYX STANDARD LIBRARY: SOVEREIGN GOAT 5NITRO+ & HOUSE-MONEY PYRAMID ENGINE
// Module: std/finance/goat_5nitro_pyramid.nyx
//
// Forensic Reverse-Engineering & Institutional Upgrade of:
//   1. @tradinggoat1 / t.me/robotMT ('Huayra Automatic Robot' / '5NITRO+™'):
//      - 5-Oscillator Consensus Matrix [0.0 to 100.0%]:
//          * T3  : Fast Tilson-Smoothed EMA-8 vs EMA-21 Ribbon
//          * SS  : Stochastic (14, 3, 3) %K vs %D & Mid-Line Momentum
//          * MAC : MACD (12, 26, 9) Histogram Acceleration & Zero-Line Bias
//          * RVI : Relative Vigor Index (10, 4) Close-Open / High-Low Vigor
//          * AO  : Bill Williams Awesome Oscillator (SMA-5 - SMA-34 Median)
//      - Multi-Horizon Alignment Filter (M10 / M20 / H1 Macro Umbrella)
//      - Stepped Donchian / Fractal Support-Resistance Channel + Floor Pivots
//   2. The "S/L Trailed Past Entry" Profit-Lock Signature:
//      - Replicates the exact ledger mechanic seen in @tradinggoat1's MT4
//        history where open trades carry Stop-Loss levels deep inside profit
//        (+0.20R to +1.80R beyond initial entry price).
//   3. Sovereign Risk-Free "House-Money" In-Wave Burst Pyramid:
//      - Replaces dangerous simultaneous 10-order martingale stacking on $60
//        accounts with a zero-additional-risk 2-stage sequential burst:
//        * Stage 1 (Scout Sniper): Enters Leg #1 on 5NITRO+ (>= 65%) + SKEW/LETW
//          or Stepped Donchian Channel Bounce with bounded structural SL.
//        * Stage 2 (Risk-Free Lock): When excursion >= +1.15R, Leg #1 SL locks
//          at Entry + 0.20R (or Entry - 0.20R for shorts). Net risk = 0.00R!
//        * Stage 3 (House-Money Burst): While Leg #1 is locked risk-free and
//          5NITRO+ remains >= 65% in trend direction, fires Leg #2 (0.85x size)
//          and ratchets combined SL to weighted breakeven+ (+0.10R), boosting
//          single-wave yield from +3.0R to +5.2R with zero blowup risk.
//   4. Small-Account ($60 -> $1,000+) Milestone Equity Ratchet:
//      - Computes exact MT5 lot size from $60 starting equity while locking
//        equity floors at $100, $250, $500, $1,000, $2,500, and $5,000.
// ============================================================================

struct Nitro5Consensus {
    bull_pct: f64,
    bear_pct: f64,
    direction: int,
    t3_score: f64,
    stoch_score: f64,
    macd_score: f64,
    rvi_score: f64,
    ao_score: f64,
    multi_tf_aligned: bool
}

struct SteppedChannelState {
    upper_resistance: f64,
    lower_support: f64,
    mid_channel: f64,
    pivot_point: f64,
    r1_level: f64,
    s1_level: f64,
    touch_lower_bounce: bool,
    touch_upper_reject: bool
}

struct HouseMoneyPyramidState {
    direction: int,
    leg1_entry: f64,
    leg1_sl: f64,
    leg1_tp: f64,
    initial_risk: f64,
    leg1_risk_free: bool,
    leg2_active: bool,
    leg2_entry: f64,
    combined_sl: f64,
    expected_wave_r: f64
}

struct SmallAccountLotPlan {
    current_equity: f64,
    locked_floor_equity: f64,
    effective_risk_pct: f64,
    dollar_risk: f64,
    leg1_lots: f64,
    leg2_burst_lots: f64
}

fn abs_f64(val: f64) -> f64 {
    if val < 0.0 {
        return -val;
    }
    return val;
}

fn max_f64(a: f64, b: f64) -> f64 {
    if a > b {
        return a;
    }
    return b;
}

fn min_f64(a: f64, b: f64) -> f64 {
    if a < b {
        return a;
    }
    return b;
}

fn clamp_f64(val: f64, lo: f64, hi: f64) -> f64 {
    if val < lo {
        return lo;
    }
    if val > hi {
        return hi;
    }
    return val;
}

// ============================================================================
// 1. 5NITRO+ MULTI-OSCILLATOR CONSENSUS MATRIX (T3 + SS + MAC + RVI + AO)
// ============================================================================
fn compute_5nitro_consensus(
    close_now: f64,
    ema8_t3: f64,
    ema21_slow: f64,
    stoch_k: f64,
    stoch_d: f64,
    macd_hist_now: f64,
    macd_hist_prev: f64,
    rvi_val: f64,
    rvi_sig: f64,
    ao_now: f64,
    ao_prev: f64,
    h1_ema10: f64,
    h1_ema30: f64,
    m5_ema50_now: f64,
    m5_ema50_lag4: f64
) -> Nitro5Consensus {
    // 1. T3 (Tilson Fast Ribbon vs EMA-21)
    let mut t3_s = 0.0;
    if ema8_t3 > ema21_slow {
        t3_s = 0.5;
        if close_now > ema8_t3 {
            t3_s = 1.0;
        }
    } else {
        if close_now > ema21_slow {
            t3_s = 0.5;
        }
    }

    // 2. SS (Stochastic 14, 3, 3)
    let mut ss_s = 0.0;
    if stoch_k > stoch_d {
        ss_s = 0.5;
        if stoch_k > 50.0 {
            if stoch_k < 88.0 {
                ss_s = 1.0;
            }
        }
    } else {
        if stoch_k > 52.0 {
            ss_s = 0.5;
        }
    }

    // 3. MAC (MACD 12, 26, 9 Histogram Slope & Bias)
    let mut mac_s = 0.0;
    if macd_hist_now > 0.0 {
        mac_s = 0.5;
        if macd_hist_now >= macd_hist_prev {
            mac_s = 1.0;
        }
    } else {
        if macd_hist_now > macd_hist_prev {
            mac_s = 0.5;
        }
    }

    // 4. RVI (Relative Vigor Index 10, 4)
    let mut rvi_s = 0.0;
    if rvi_val > rvi_sig {
        rvi_s = 0.5;
        if rvi_val > 0.0 {
            rvi_s = 1.0;
        }
    } else {
        if rvi_val > 0.0 {
            rvi_s = 0.5;
        }
    }

    // 5. AO (Bill Williams Awesome Oscillator SMA5 - SMA34)
    let mut ao_s = 0.0;
    if ao_now > 0.0 {
        ao_s = 0.5;
        if ao_now >= ao_prev {
            ao_s = 1.0;
        }
    } else {
        if ao_now > ao_prev {
            ao_s = 0.5;
        }
    }

    let bull_pct = ((t3_s + ss_s + mac_s + rvi_s + ao_s) / 5.0) * 100.0;
    let bear_pct = 100.0 - bull_pct;

    let mut dir = 0;
    if bull_pct >= 62.0 {
        dir = 1;
    } else {
        if bear_pct >= 62.0 {
            dir = -1;
        }
    }

    let mut mtf_ok = false;
    if dir == 1 {
        if h1_ema10 >= h1_ema30 {
            if m5_ema50_now >= m5_ema50_lag4 {
                mtf_ok = true;
            }
        }
    } else {
        if dir == -1 {
            if h1_ema10 <= h1_ema30 {
                if m5_ema50_now <= m5_ema50_lag4 {
                    mtf_ok = true;
                }
            }
        }
    }

    return Nitro5Consensus {
        bull_pct: bull_pct,
        bear_pct: bear_pct,
        direction: dir,
        t3_score: t3_s,
        stoch_score: ss_s,
        macd_score: mac_s,
        rvi_score: rvi_s,
        ao_score: ao_s,
        multi_tf_aligned: mtf_ok
    };
}

// ============================================================================
// 2. STEPPED DONCHIAN FRACTAL CHANNEL & FLOOR PIVOTS
// ============================================================================
fn evaluate_stepped_channel(
    donchian_high_20: f64,
    donchian_low_20: f64,
    prev_session_high: f64,
    prev_session_low: f64,
    prev_session_close: f64,
    bar_open: f64,
    bar_high: f64,
    bar_low: f64,
    bar_close: f64,
    prev_bar_low: f64,
    prev_bar_high: f64,
    atr: f64
) -> SteppedChannelState {
    let mid_c = 0.5 * (donchian_high_20 + donchian_low_20);
    let pp = (prev_session_high + prev_session_low + prev_session_close) / 3.0;
    let r1 = (2.0 * pp) - prev_session_low;
    let s1 = (2.0 * pp) - prev_session_high;

    let min_l = min_f64(bar_low, prev_bar_low);
    let max_h = max_f64(bar_high, prev_bar_high);

    let mut bounce_bull = false;
    if min_l <= (donchian_low_20 + (0.65 * atr)) {
        if bar_close > bar_open {
            if bar_close <= (mid_c + (0.35 * atr)) {
                bounce_bull = true;
            }
        }
    }

    let mut reject_bear = false;
    if max_h >= (donchian_high_20 - (0.65 * atr)) {
        if bar_close < bar_open {
            if bar_close >= (mid_c - (0.35 * atr)) {
                reject_bear = true;
            }
        }
    }

    return SteppedChannelState {
        upper_resistance: donchian_high_20,
        lower_support: donchian_low_20,
        mid_channel: mid_c,
        pivot_point: pp,
        r1_level: r1,
        s1_level: s1,
        touch_lower_bounce: bounce_bull,
        touch_upper_reject: reject_bear
    };
}

// ============================================================================
// 3. THE "S/L TRAILED PAST ENTRY" & RISK-FREE HOUSE-MONEY BURST RATCHET
// ============================================================================
fn evaluate_house_money_burst_ratchet(
    state: HouseMoneyPyramidState,
    bar_high: f64,
    bar_low: f64,
    bar_close: f64,
    prev_2bar_low: f64,
    prev_2bar_high: f64,
    atr: f64,
    nitro_consensus_pct: f64
) -> HouseMoneyPyramidState {
    let safe_risk = max_f64(state.initial_risk, 0.00001);
    let mut new_sl = state.combined_sl;
    let mut is_rf = state.leg1_risk_free;
    let mut leg2_on = state.leg2_active;
    let mut leg2_px = state.leg2_entry;
    let mut exp_r = state.expected_wave_r;

    if state.direction == 1 {
        let excursion_r = (bar_high - state.leg1_entry) / safe_risk;

        if excursion_r >= 1.15 {
            is_rf = true;
            let lock_sl = state.leg1_entry + (0.20 * safe_risk);
            if lock_sl > new_sl {
                new_sl = lock_sl;
            }
        }

        if is_rf == true {
            if leg2_on == false {
                let close_r = (bar_close - state.leg1_entry) / safe_risk;
                if close_r >= 1.10 {
                    if close_r <= 2.15 {
                        if nitro_consensus_pct >= 65.0 {
                            leg2_on = true;
                            leg2_px = bar_close;
                            exp_r = 5.20;
                            let burst_safe_sl = (0.5 * (state.leg1_entry + leg2_px)) - (0.05 * safe_risk);
                            if burst_safe_sl > new_sl {
                                new_sl = burst_safe_sl;
                            }
                        }
                    }
                }
            }
        }

        if excursion_r >= 1.85 {
            let struct_sl = prev_2bar_low - (0.15 * atr);
            let lock_1r = state.leg1_entry + (0.95 * safe_risk);
            let best_trail = max_f64(struct_sl, lock_1r);
            if best_trail > new_sl {
                if best_trail < bar_close {
                    new_sl = best_trail;
                }
            }
        }
    } else {
        if state.direction == -1 {
            let excursion_r = (state.leg1_entry - bar_low) / safe_risk;

            if excursion_r >= 1.15 {
                is_rf = true;
                let lock_sl = state.leg1_entry - (0.20 * safe_risk);
                if lock_sl < new_sl {
                    new_sl = lock_sl;
                }
            }

            if is_rf == true {
                if leg2_on == false {
                    let close_r = (state.leg1_entry - bar_close) / safe_risk;
                    if close_r >= 1.10 {
                        if close_r <= 2.15 {
                            if nitro_consensus_pct >= 65.0 {
                                leg2_on = true;
                                leg2_px = bar_close;
                                exp_r = 5.20;
                                let burst_safe_sl = (0.5 * (state.leg1_entry + leg2_px)) + (0.05 * safe_risk);
                                if burst_safe_sl < new_sl {
                                    new_sl = burst_safe_sl;
                                }
                            }
                        }
                    }
                }
            }

            if excursion_r >= 1.85 {
                let struct_sl = prev_2bar_high + (0.15 * atr);
                let lock_1r = state.leg1_entry - (0.95 * safe_risk);
                let best_trail = min_f64(struct_sl, lock_1r);
                if best_trail < new_sl {
                    if best_trail > bar_close {
                        new_sl = best_trail;
                    }
                }
            }
        }
    }

    return HouseMoneyPyramidState {
        direction: state.direction,
        leg1_entry: state.leg1_entry,
        leg1_sl: state.leg1_sl,
        leg1_tp: state.leg1_tp,
        initial_risk: state.initial_risk,
        leg1_risk_free: is_rf,
        leg2_active: leg2_on,
        leg2_entry: leg2_px,
        combined_sl: new_sl,
        expected_wave_r: exp_r
    };
}

// ============================================================================
// 4. $60 -> $1,000+ SMALL-ACCOUNT MILESTONE EQUITY RATCHET & LOT SIZER
// ============================================================================
fn compute_goat_lot_size_from_60(
    current_equity: f64,
    peak_equity: f64,
    base_risk_pct: f64,
    stop_distance_price: f64,
    contract_value_per_point: f64
) -> SmallAccountLotPlan {
    let mut floor_eq = 0.0;
    if peak_equity >= 5000.0 {
        floor_eq = 4250.0;
    } else {
        if peak_equity >= 2500.0 {
            floor_eq = 2125.0;
        } else {
            if peak_equity >= 1000.0 {
                floor_eq = 850.0;
            } else {
                if peak_equity >= 500.0 {
                    floor_eq = 425.0;
                } else {
                    if peak_equity >= 250.0 {
                        floor_eq = 212.5;
                    } else {
                        if peak_equity >= 100.0 {
                            floor_eq = 85.0;
                        }
                    }
                }
            }
        }
    }

    let mut eff_risk = base_risk_pct;
    if floor_eq > 0.0 {
        if current_equity <= (floor_eq * 1.12) {
            eff_risk = base_risk_pct * 0.50;
        }
    }

    let dollar_risk = current_equity * (eff_risk / 100.0);
    let safe_stop = max_f64(stop_distance_price, 0.10);
    let risk_per_lot = safe_stop * max_f64(contract_value_per_point, 1.0);
    let raw_lots = dollar_risk / max_f64(risk_per_lot, 0.01);

    let leg1_lots = clamp_f64(raw_lots, 0.01, 50.0);
    let leg2_lots = clamp_f64(leg1_lots * 0.85, 0.01, 50.0);

    return SmallAccountLotPlan {
        current_equity: current_equity,
        locked_floor_equity: floor_eq,
        effective_risk_pct: eff_risk,
        dollar_risk: dollar_risk,
        leg1_lots: leg1_lots,
        leg2_burst_lots: leg2_lots
    };
}
