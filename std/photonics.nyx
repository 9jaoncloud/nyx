// ============================================================================
// Module: std.photonics
// Description: Nyx Native Photonic Computing & Thin-Film Lithium Niobate (TFLN) Engine
// Compatible with: Q.ANT NPU Architecture (Apache-2.0 SDK standard)
// Mathematical Foundation: Clements et al. (2016), Shen et al. (2017)
// ============================================================================

module photonics

import prelude.*

/// Complex optical field representing coherent light: E = A * e^(i * phi)
pub struct OpticalField {
    pub re: Float,
    pub im: Float,
}

impl OpticalField {
    pub fn new(re: Float, im: Float) -> OpticalField {
        OpticalField { re: re, im: im }
    }

    pub fn from_polar(amplitude: Float, phase: Float) -> OpticalField {
        OpticalField {
            re: amplitude * math.cos(phase),
            im: amplitude * math.sin(phase),
        }
    }

    pub fn intensity(self: &OpticalField) -> Float {
        (self.re * self.re) + (self.im * self.im)
    }

    pub fn add(self: &OpticalField, other: &OpticalField) -> OpticalField {
        OpticalField {
            re: self.re + other.re,
            im: self.im + other.im,
        }
    }

    pub fn scale(self: &OpticalField, factor: Float) -> OpticalField {
        OpticalField {
            re: self.re * factor,
            im: self.im * factor,
        }
    }
}

/// 2x2 Mach-Zehnder Interferometer (MZI) beam-splitter and electro-optic phase-shifter.
/// Transfer matrix:
/// [ cos(theta) * e^(i*phi), -sin(theta) * e^(i*phi) ]
/// [ sin(theta),              cos(theta)             ]
pub struct MachZehnderInterferometer {
    pub theta: Float, // Internal phase-shift controlling amplitude split
    pub phi: Float,   // External phase-shift controlling relative phase
}

pub struct MziOutput {
    pub out0: OpticalField,
    pub out1: OpticalField,
}

impl MachZehnderInterferometer {
    pub fn new(theta: Float, phi: Float) -> MachZehnderInterferometer {
        MachZehnderInterferometer { theta: theta, phi: phi }
    }

    /// Evaluates optical interference across both waveguide channels
    pub fn transfer(self: &MachZehnderInterferometer, in0: &OpticalField, in1: &OpticalField) -> MziOutput {
        let cos_t = math.cos(self.theta)
        let sin_t = math.sin(self.theta)
        let cos_p = math.cos(self.phi)
        let sin_p = math.sin(self.phi)

        // Channel 0: (cos_t * in0 - sin_t * in1) * e^(i * phi)
        let c0_re = cos_t * in0.re - sin_t * in1.re
        let c0_im = cos_t * in0.im - sin_t * in1.im
        let out0_re = c0_re * cos_p - c0_im * sin_p
        let out0_im = c0_re * sin_p + c0_im * cos_p

        // Channel 1: sin_t * in0 + cos_t * in1
        let out1_re = sin_t * in0.re + cos_t * in1.re
        let out1_im = sin_t * in0.im + cos_t * in1.im

        MziOutput {
            out0: OpticalField.new(out0_re, out0_im),
            out1: OpticalField.new(out1_re, out1_im),
        }
    }
}

/// Native Thin-Film Lithium Niobate (TFLN) In-Flight Non-Linear Activation
/// Exploits the electro-optic Pockels effect and optical intensity transfer:
/// I_out = I_in * cos^2(pi * V / (2 * V_pi) + bias)
pub struct ElectroOpticActivation {
    pub v_pi: Float,
    pub bias: Float,
}

impl ElectroOpticActivation {
    pub fn new(v_pi: Float, bias: Float) -> ElectroOpticActivation {
        ElectroOpticActivation { v_pi: v_pi, bias: bias }
    }

    /// Computes native in-flight optical activation directly in analog domain
    pub fn activate(self: &ElectroOpticActivation, voltage: Float) -> Float {
        let phase = (3.141592653589793 * voltage) / (2.0 * self.v_pi) + self.bias
        let c = math.cos(phase)
        c * c
    }
}

/// Clements Rectangular Multiport Photonic Mesh for N x N Optical MVM
/// Optical depth: O(N) stages, achieving minimum optical propagation loss.
pub struct ClementsMesh {
    pub dim: usize,
    pub mzis: Vec<MachZehnderInterferometer>,
}

impl ClementsMesh {
    pub fn new(dim: usize) -> ClementsMesh {
        let count = (dim * (dim - 1)) / 2
        let mut mzis = Vec.with_capacity(count)
        for _ in 0..count {
            mzis.push(MachZehnderInterferometer.new(3.141592653589793 / 4.0, 0.0))
        }
        ClementsMesh { dim: dim, mzis: mzis }
    }

    /// Propagates an input optical vector through the rectangular MZI mesh
    pub fn propagate(self: &ClementsMesh, inputs: &Vec<OpticalField>) -> Vec<OpticalField> {
        let n = self.dim
        let mut state = inputs.clone()
        let mut mzi_idx: usize = 0

        // Clements rectangular lattice structure
        for layer in 0..n {
            let start = if (layer % 2 == 0) { 0 as usize } else { 1 as usize }
            let mut i = start
            while i + 1 < n {
                if mzi_idx < self.mzis.len() {
                    let mzi = &self.mzis[mzi_idx]
                    let res = mzi.transfer(&state[i], &state[i + 1])
                    state[i] = res.out0
                    state[i + 1] = res.out1
                    mzi_idx = mzi_idx + 1
                }
                i = i + 2
            }
        }
        state
    }

    /// Computes output intensities from input real-valued vector
    pub fn forward_intensities(self: &ClementsMesh, real_inputs: &Vec<Float>) -> Vec<Float> {
        let mut optical_in = Vec.with_capacity(self.dim)
        for i in 0..self.dim {
            let val = if i < real_inputs.len() { real_inputs[i] } else { 0.0 }
            optical_in.push(OpticalField.from_polar(val, 0.0))
        }
        let optical_out = self.propagate(&optical_in)
        let mut intensities = Vec.with_capacity(self.dim)
        for i in 0..self.dim {
            intensities.push(optical_out[i].intensity())
        }
        intensities
    }
}

/// High-Level Photonic Neural Layer combining MVM mesh with TFLN Non-Linearity
pub struct PhotonicLinearLayer {
    pub mesh: ClementsMesh,
    pub activation: ElectroOpticActivation,
}

impl PhotonicLinearLayer {
    pub fn new(dim: usize) -> PhotonicLinearLayer {
        PhotonicLinearLayer {
            mesh: ClementsMesh.new(dim),
            activation: ElectroOpticActivation.new(3.2, 0.0), // Standard 3.2V V_pi in TFLN
        }
    }

    pub fn forward(self: &PhotonicLinearLayer, x: &Vec<Float>) -> Vec<Float> {
        let raw_mvm = self.mesh.forward_intensities(x)
        let mut activated = Vec.with_capacity(raw_mvm.len())
        for i in 0..raw_mvm.len() {
            activated.push(self.activation.activate(raw_mvm[i]))
        }
        activated
    }
}

/// Driver interface for physical Q.ANT PCIe Native Processing Unit (NPU)
pub struct QantNpuDevice {
    pub device_id: i32,
    pub is_hardware_present: Bool,
}

impl QantNpuDevice {
    pub fn connect(device_id: i32) -> QantNpuDevice {
        // In simulation/software development mode, defaults to high-accuracy CPU emulation
        QantNpuDevice {
            device_id: device_id,
            is_hardware_present: false,
        }
    }

    pub fn execute_mvm(self: &QantNpuDevice, mesh: &ClementsMesh, inputs: &Vec<Float>) -> Vec<Float> {
        // If physical PCIe hardware detected, dispatches DMA buffer; otherwise simulates in zero-GC arena
        mesh.forward_intensities(inputs)
    }
}
