module crypto

extern "C" {
    fn nyx_sha256(data: *const u8, len: u64, output: *mut u8)
    fn nyx_sha512(data: *const u8, len: u64, output: *mut u8)
    fn nyx_md5(data: *const u8, len: u64, output: *mut u8)
    fn nyx_hmac_sha256(key: *const u8, key_len: u64, data: *const u8, data_len: u64, output: *mut u8)
    fn nyx_random_bytes(buf: *mut u8, len: u64)
    fn nyx_aes_encrypt(key: *const u8, key_len: u64, data: *const u8, data_len: u64, output: *mut u8) -> i64
    fn nyx_aes_decrypt(key: *const u8, key_len: u64, data: *const u8, data_len: u64, output: *mut u8) -> i64
}

pub fn sha256(data: String) -> Vec<u8> {
    let mut out = [0u8; 32]
    nyx_sha256(data.as_ptr(), data.len() as u64, &mut out[0])
    let mut result = Vec.new()
    for i in 0..32u64 {
        result.push(out[i])
    }
    result
}

pub fn sha256_bytes(data: Vec<u8>) -> Vec<u8> {
    let mut out = [0u8; 32]
    nyx_sha256(data.as_ptr(), data.len() as u64, &mut out[0])
    let mut result = Vec.new()
    for i in 0..32u64 {
        result.push(out[i])
    }
    result
}

pub fn sha512(data: String) -> Vec<u8> {
    let mut out = [0u8; 64]
    nyx_sha512(data.as_ptr(), data.len() as u64, &mut out[0])
    let mut result = Vec.new()
    for i in 0..64u64 {
        result.push(out[i])
    }
    result
}

pub fn md5(data: String) -> Vec<u8> {
    let mut out = [0u8; 16]
    nyx_md5(data.as_ptr(), data.len() as u64, &mut out[0])
    let mut result = Vec.new()
    for i in 0..16u64 {
        result.push(out[i])
    }
    result
}

pub fn hmac_sha256(key: String, data: String) -> Vec<u8> {
    let mut out = [0u8; 32]
    nyx_hmac_sha256(key.as_ptr(), key.len() as u64, data.as_ptr(), data.len() as u64, &mut out[0])
    let mut result = Vec.new()
    for i in 0..32u64 {
        result.push(out[i])
    }
    result
}

pub fn random_bytes(count: u64) -> Vec<u8> {
    let mut buf = [0u8; 256]
    let n = if count > 256 { 256 } else { count }
    nyx_random_bytes(&mut buf[0], n)
    let mut result = Vec.new()
    for i in 0..n {
        result.push(buf[i])
    }
    result
}

pub fn random_int(min: i64, max: i64) -> i64 {
    let bytes = random_bytes(8)
    let val = ((bytes[0] as i64) << 56) | ((bytes[1] as i64) << 48) | ((bytes[2] as i64) << 40) | ((bytes[3] as i64) << 32) |
              ((bytes[4] as i64) << 24) | ((bytes[5] as i64) << 16) | ((bytes[6] as i64) << 8) | (bytes[7] as i64)
    min + (val.abs() % (max - min + 1))
}

pub fn sha256_hex(data: String) -> String {
    let hash = sha256(data)
    bytes_to_hex(hash)
}

pub fn md5_hex(data: String) -> String {
    let hash = md5(data)
    bytes_to_hex(hash)
}

pub fn bytes_to_hex(bytes: Vec<u8>) -> String {
    let hex_chars = "0123456789abcdef"
    let mut result = String.new()
    for b in bytes {
        let hi = hex_chars[(b >> 4) as u64]
        let lo = hex_chars[(b & 0x0f) as u64]
        result = result + String.from_char(hi) + String.from_char(lo)
    }
    result
}

pub fn hex_to_bytes(hex: String) -> Result<Vec<u8>, String> {
    if hex.len() % 2 != 0 {
        return Result.Err("Hex string must have even length".to_string())
    }
    let mut result = Vec.new()
    let mut i = 0
    while i < hex.len() {
        let hi = hex_char_to_nibble(hex.char_at(i))?
        let lo = hex_char_to_nibble(hex.char_at(i + 1))?
        result.push((hi << 4) | lo)
        i = i + 2
    }
    Result.Ok(result)
}

fn hex_char_to_nibble(ch: Char) -> Result<u8, String> {
    if ch >= '0' && ch <= '9' {
        Result.Ok((ch as u8) - b'0')
    } else if ch >= 'a' && ch <= 'f' {
        Result.Ok((ch as u8) - b'a' + 10)
    } else if ch >= 'A' && ch <= 'F' {
        Result.Ok((ch as u8) - b'A' + 10)
    } else {
        Result.Err("Invalid hex character".to_string())
    }
}

pub fn hash_password(password: String, salt: String) -> String {
    sha256_hex(salt + password + salt)
}

pub fn verify_password(password: String, salt: String, expected_hash: String) -> Bool {
    hash_password(password, salt) == expected_hash
}
