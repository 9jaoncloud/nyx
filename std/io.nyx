module io

extern "C" {
    fn rt_println(s: *const u8, len: u64)
    fn rt_print_int(n: i64)
    fn rt_print_float(f: f64)
    fn rt_eprintln(s: *const u8, len: u64)
}

pub fn println(s: String) {
    rt_println(s.as_ptr(), s.len() as u64)
}

pub fn print(s: String) {
    rt_println(s.as_ptr(), s.len() as u64)
}

pub fn eprintln(s: String) {
    rt_eprintln(s.as_ptr(), s.len() as u64)
}

pub fn eprint(s: String) {
    rt_eprintln(s.as_ptr(), s.len() as u64)
}

pub fn print_int(n: i64) {
    rt_print_int(n)
}

pub fn print_float(f: f64) {
    rt_print_float(f)
}

pub fn println_int(n: i64) {
    rt_print_int(n)
    println("\n".to_string())
}

pub fn println_float(f: f64) {
    rt_print_float(f)
    println("\n".to_string())
}

pub fn format(s: String) -> String {
    s
}

pub fn format_int(n: i64) -> String {
    n.to_string()
}

pub fn format_float(f: f64) -> String {
    f.to_string()
}

pub fn read_line() -> String {
    let mut buf = [0u8; 4096]
    let n = rt_read_stdin(&mut buf[0], 4096)
    if n > 0 {
        String.from_utf8(buf[0..n as u64])
    } else {
        "".to_string()
    }
}

pub fn read_all() -> String {
    let mut result = String.new()
    loop {
        let line = read_line()
        if line.len() == 0 { break }
        result = result + line + "\n"
    }
    result
}

extern "C" {
    fn rt_read_stdin(buf: *mut u8, len: u64) -> i64
}
