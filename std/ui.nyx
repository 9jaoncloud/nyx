        nyx_skia_draw_text(null, "Nyx UI Tree Dump: [Window -> Scaffold -> Column -> (Padding, SizedBox, Expanded)]".as_ptr(), 10.0, 30.0, 12.0, 0x818CF8FF)
    }
}


