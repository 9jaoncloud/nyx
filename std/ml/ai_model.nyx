module ai_model

import std.io
import std.string
import std.vec
import std.math

pub struct AiModelClient {
    pub provider: String,
    pub model_name: String,
    pub api_key: String,
    pub base_url: String,
    pub temperature: f64,
}

pub fn create_openai_client(model: String, api_key: String) -> AiModelClient {
    AiModelClient {
        provider: "OpenAI".to_string(),
        model_name: model,
        api_key: api_key,
        base_url: "https://api.openai.com/v1".to_string(),
        temperature: 0.7,
    }
}

pub fn create_anthropic_client(model: String, api_key: String) -> AiModelClient {
    AiModelClient {
        provider: "Anthropic".to_string(),
        model_name: model,
        api_key: api_key,
        base_url: "https://api.anthropic.com/v1".to_string(),
        temperature: 0.7,
    }
}

pub fn create_gemini_client(model: String, api_key: String) -> AiModelClient {
    AiModelClient {
        provider: "Google_Gemini".to_string(),
        model_name: model,
        api_key: api_key,
        base_url: "https://generativelanguage.googleapis.com/v1beta".to_string(),
        temperature: 0.7,
    }
}

pub fn create_deepseek_client(model: String, api_key: String) -> AiModelClient {
    AiModelClient {
        provider: "DeepSeek".to_string(),
        model_name: model,
        api_key: api_key,
        base_url: "https://api.deepseek.com/v1".to_string(),
