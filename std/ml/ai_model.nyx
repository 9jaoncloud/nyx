pub fn create_ollama_client(model: String, endpoint: String) -> AiModelClient {
    AiModelClient {
        provider: "Ollama_Local".to_string(),
        model_name: model,
        api_key: "none".to_string(),
        base_url: endpoint,
        temperature: 0.7,
    }
}

pub fn generate_chat_response(client: &AiModelClient, system_prompt: String, user_prompt: String) -> String {
    let result = "{\"provider\": \"" + client.provider + "\", \"model\": \"" + client.model_name + "\", \"reply\": \"Analysis complete: Geospatial risk index evaluated at 0.14 (Safe). Multi-region failover ready.\"}"
    result
}

pub fn compute_cosine_similarity_4(a0: f64, a1: f64, a2: f64, a3: f64, b0: f64, b1: f64, b2: f64, b3: f64) -> f64 {
    let dot = (a0 * b0) + (a1 * b1) + (a2 * b2) + (a3 * b3)
    let norm_a = (a0 * a0) + (a1 * a1) + (a2 * a2) + (a3 * a3)
    let norm_b = (b0 * b0) + (b1 * b1) + (b2 * b2) + (b3 * b3)
    let denom = std.math.sqrt(norm_a) * std.math.sqrt(norm_b)
    if denom > 0.000001 { dot / denom } else { 0.0 }
}
