module std.mobile.ble

pub struct BleDeviceFrame {
    pub device_uuid: String,
    pub rssi_dbm: i64,
    pub packet_len: i64,
    pub is_authenticated: bool
}

pub struct HapticController {
    pub waveform_id: i64,
    pub intensity_percent: i64,
    pub duration_ms: i64
}

impl BleDeviceFrame {
    pub fn new(uuid: String, rssi: i64) -> BleDeviceFrame {
        BleDeviceFrame {
            device_uuid: uuid,
            rssi_dbm: rssi,
            packet_len: 31,
            is_authenticated: true
        }
    }

    pub fn is_signal_strong(self: &BleDeviceFrame) -> bool {
        if self.rssi_dbm >= -75 {
            true
        } else {
            false
        }
    }
}

impl HapticController {
    pub fn new_sharp_click() -> HapticController {
        HapticController {
            waveform_id: 1,
            intensity_percent: 100,
            duration_ms: 12
        }
    }

    pub fn trigger_haptic(self: &HapticController) -> bool {
        if self.duration_ms > 0 {
            true
        } else {
            false
        }
    }
}
