// ============================================================================
//   NYX MOBILE: ACCESSIBILITY (SCREEN READERS), DYNAMIC TYPE & RTL BIDI ENGINE
//   Module: std.mobile.a11y
//   Compliance: W3C WAI-ARIA, Apple VoiceOver / Dynamic Type, Android TalkBack
// ============================================================================

module a11y

import std.string
import std.vec
import std.option
import std.result

// ── 1. Accessibility Traits & Semantic Screen Reader Nodes ─────────────────

pub enum AccessibilityTrait {
    Button,
    Header,
    Link,
    Image,
    Selected,
    PlaysSound,
    KeyboardKey,
    SummaryElement,
    NotEnabled,
    SearchField,
}

pub enum LiveRegionMode {
    None,
    Polite,    // Speaks when user is idle
    Assertive, // Interrupts current speech immediately for urgent warnings
}

pub struct AccessibilityNode {
    pub label: String,            // Primary spoken announcement
    pub hint: Option<String>,     // Action guide e.g. "Double-tap to confirm transfer"
    pub value: Option<String>,    // e.g. "75 percent"
    pub traits: Vec<AccessibilityTrait>,
    pub live_region: LiveRegionMode,
    pub is_screen_reader_focused: Bool,
}

// ── 2. Dynamic Type & User Vision Preferences ─────────────────────────────

pub enum DynamicTypeScale {
    ExtraSmall = 1,
    Small = 2,
    Medium = 3,       // Standard baseline (100%)
    Large = 4,
    ExtraLarge = 5,
    ExtraExtraLarge = 6,
    AccessibilityLarge = 7,
    AccessibilityMax = 8, // Up to 300% magnification
}

pub struct VisionPreferences {
    pub type_scale: DynamicTypeScale,
    pub is_screen_reader_active: Bool,
    pub is_bold_text_enabled: Bool,
    pub is_high_contrast_active: Bool,
    pub is_reduced_motion_requested: Bool,
}

// ── 3. Internationalization & Right-to-Left (RTL) Bidirectional Layout ────

pub enum LayoutDirection {
    LeftToRight, // LTR: English, Spanish, Yoruba, Swahili, etc.
    RightToLeft, // RTL: Arabic, Hebrew, Urdu, Persian
}

pub struct LocaleContext {
    pub language_code: String,    // e.g. "ar", "he", "en", "ha"
    pub country_code: String,     // e.g. "SA", "IL", "US", "NG"
    pub layout_direction: LayoutDirection,
    pub currency_symbol: String,
}

pub struct AccessibilityController {
    pub vision_prefs: VisionPreferences,
    pub locale: LocaleContext,
}

impl AccessibilityController {
    pub fn new() -> AccessibilityController {
        AccessibilityController {
            vision_prefs: VisionPreferences {
                type_scale: DynamicTypeScale.Medium,
                is_screen_reader_active: false,
                is_bold_text_enabled: false,
                is_high_contrast_active: false,
                is_reduced_motion_requested: false,
            },
            locale: LocaleContext {
                language_code: "en".to_string(),
                country_code: "US".to_string(),
                layout_direction: LayoutDirection.LeftToRight,
                currency_symbol: "$".to_string(),
            },
        }
    }

    // Configure RTL layout for Arabic/Hebrew locales
    pub fn set_locale(&mut self, lang: String, country: String) {
        self.locale.language_code = lang.clone();
        self.locale.country_code = country;

        if lang == "ar" || lang == "he" || lang == "ur" || lang == "fa" {
            self.locale.layout_direction = LayoutDirection.RightToLeft;
        } else {
            self.locale.layout_direction = LayoutDirection.LeftToRight;
        }
    }

    // Post speech announcement to TalkBack or VoiceOver
    pub fn announce_for_accessibility(&self, message: String, is_urgent: Bool) {
        let mode = if is_urgent { LiveRegionMode.Assertive } else { LiveRegionMode.Polite };
        // Dispatches to OS accessibility daemon
    }

    // Compute layout coordinate mirroring when in RTL mode
    pub fn resolve_horizontal_offset(&self, left_dp: f32, container_width_dp: f32, element_width_dp: f32) -> f32 {
        if self.locale.layout_direction == LayoutDirection.RightToLeft {
            return container_width_dp - left_dp - element_width_dp;
        }
        return left_dp;
    }
}
