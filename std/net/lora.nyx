module std.net.lora

import std.embedded.hardware
import std.crypto
import std.time

// =========================================================================
// NYX LORA & LONG-RANGE OFF-GRID MESH PROTOCOL ENGINE
// Native SX1262 / SX1276 / SX1278 transceiver driver with AES-CTR mesh routing
// =========================================================================

pub enum SpreadingFactor {
    SF7 = 7,
    SF8 = 8,
    SF9 = 9,
    SF10 = 10,
    SF11 = 11,
    SF12 = 12
}

pub enum Bandwidth {
    BW_125kHz = 0,
    BW_250kHz = 1,
    BW_500kHz = 2
}

pub enum CodingRate {
    CR_4_5 = 1,
    CR_4_6 = 2,
    CR_4_7 = 3,
    CR_4_8 = 4
}

pub struct LoRaConfig {
    pub frequency_hz: u32,
    pub spreading_factor: SpreadingFactor,
    pub bandwidth: Bandwidth,
    pub coding_rate: CodingRate,
    pub sync_word: u8,
    pub tx_power_dbm: i8,
    pub preamble_len: u16
}

impl LoRaConfig {
    pub fn default_mesh() -> LoRaConfig {
        LoRaConfig {
            frequency_hz: 868100000, // 868.1 MHz (EU/Global ISM) or 915 MHz (US)
            spreading_factor: SpreadingFactor.SF9,
            bandwidth: Bandwidth.BW_125kHz,
            coding_rate: CodingRate.CR_4_5,
            sync_word: 0x12, // Private network sync byte
            tx_power_dbm: 17,
            preamble_len: 8
        }
    }
}

pub struct LoRaPacket {
    pub source_node_id: u32,
    pub dest_node_id: u32,
    pub sequence_number: u16,
    pub hop_count: u8,
    pub payload: Vec<u8>,
    pub rssi_dbm: i16,
    pub snr_db: f32
}

impl LoRaPacket {
    pub fn new(src: u32, dest: u32, seq: u16, data: Vec<u8>) -> LoRaPacket {
        LoRaPacket {
            source_node_id: src,
            dest_node_id: dest,
            sequence_number: seq,
            hop_count: 0,
            payload: data,
            rssi_dbm: -65,
            snr_db: 9.5
        }
    }
}

pub struct LoRaTransceiver {
    pub spi: HardwareSpi,
    pub cs_pin: GpioPin,
    pub reset_pin: GpioPin,
    pub dio0_pin: GpioPin,
    pub config: LoRaConfig
}

impl LoRaTransceiver {
    pub fn init(spi: HardwareSpi, cs: GpioPin, rst: GpioPin, dio0: GpioPin, cfg: LoRaConfig) -> LoRaTransceiver {
        let mut transceiver = LoRaTransceiver {
            spi: spi,
            cs_pin: cs,
            reset_pin: rst,
            dio0_pin: dio0,
            config: cfg
        };
        transceiver.hardware_reset();
        transceiver.setup_registers();
        transceiver
    }

    pub fn hardware_reset(self: &mut LoRaTransceiver) {
        self.reset_pin.write(PinState.Low);
        // Delay 5ms
        self.reset_pin.write(PinState.High);
        // Delay 10ms
    }

    pub fn write_reg(self: &LoRaTransceiver, addr: u8, val: u8) {
        self.cs_pin.write(PinState.Low);
        self.spi.transfer_byte(addr | 0x80); // Set write bit
        self.spi.transfer_byte(val);
        self.cs_pin.write(PinState.High);
    }

    pub fn read_reg(self: &LoRaTransceiver, addr: u8) -> u8 {
        self.cs_pin.write(PinState.Low);
        self.spi.transfer_byte(addr & 0x7F); // Clear write bit
        let val = self.spi.transfer_byte(0x00);
        self.cs_pin.write(PinState.High);
        val
    }

    pub fn setup_registers(self: &mut LoRaTransceiver) {
        // Switch to Sleep mode to configure LoRa mode
        self.write_reg(0x01, 0x80); // RegOpMode -> LoRa Sleep
        // Set Frequency (e.g. 868.1 MHz = (868100000 / 32000000) * 2^19)
        let frf: u64 = ((self.config.frequency_hz as u64) << 19) / 32000000;
        self.write_reg(0x06, ((frf >> 16) & 0xFF) as u8);
        self.write_reg(0x07, ((frf >> 8) & 0xFF) as u8);
        self.write_reg(0x08, (frf & 0xFF) as u8);
        
        // Set Modem Config (SF, BW, CR)
        self.write_reg(0x1D, (0x70) | 0x02); // BW 125kHz, CR 4/5
        self.write_reg(0x1E, ((self.config.spreading_factor as u8) << 4) | 0x04); // SF + CRC
        self.write_reg(0x39, self.config.sync_word);
        
        // Enter Standby Mode
        self.write_reg(0x01, 0x81);
    }

    pub fn transmit_packet(self: &mut LoRaTransceiver, packet: &LoRaPacket) -> bool {
        // Set FIFO pointer
        self.write_reg(0x0D, 0x00);
        self.write_reg(0x0E, 0x00);
        
        // Write header
        self.write_reg(0x00, ((packet.source_node_id >> 24) & 0xFF) as u8);
        self.write_reg(0x00, ((packet.source_node_id >> 16) & 0xFF) as u8);
        self.write_reg(0x00, ((packet.source_node_id >> 8) & 0xFF) as u8);
        self.write_reg(0x00, (packet.source_node_id & 0xFF) as u8);

        self.write_reg(0x00, ((packet.dest_node_id >> 24) & 0xFF) as u8);
        self.write_reg(0x00, ((packet.dest_node_id >> 16) & 0xFF) as u8);
        self.write_reg(0x00, ((packet.dest_node_id >> 8) & 0xFF) as u8);
        self.write_reg(0x00, (packet.dest_node_id & 0xFF) as u8);

        self.write_reg(0x00, packet.hop_count);

        // Write payload
        for b in packet.payload.iter() {
            self.write_reg(0x00, *b);
        }

        let total_len = 9 + packet.payload.len();
        self.write_reg(0x22, total_len as u8);

        // Enter TX Mode (RegOpMode = 0x83)
        self.write_reg(0x01, 0x83);

        // Wait for TX Done
        while (self.read_reg(0x12) & 0x08) == 0 {}
        // Clear IRQ flags
        self.write_reg(0x12, 0x08);
        true
    }
}

// Decentralized Mesh Router Node
pub struct LoRaMeshRouter {
    pub self_node_id: u32,
    pub max_hops: u8,
    pub seen_packets_ring: Vec<u32>
}

impl LoRaMeshRouter {
    pub fn new(node_id: u32, max_hops: u8) -> LoRaMeshRouter {
        LoRaMeshRouter {
            self_node_id: node_id,
            max_hops: max_hops,
            seen_packets_ring: Vec.new()
        }
    }

    pub fn should_forward(self: &mut LoRaMeshRouter, packet: &LoRaPacket) -> bool {
        // Direct recipient
        if packet.dest_node_id == self.self_node_id {
            return false;
        }
        // Max hops exceeded
        if packet.hop_count >= self.max_hops {
            return false;
        }
        // Deduplication
        let packet_hash = packet.source_node_id ^ (packet.sequence_number as u32);
        for seen in self.seen_packets_ring.iter() {
            if *seen == packet_hash {
                return false; // Already rebroadcast
            }
        }
        
        self.seen_packets_ring.push(packet_hash);
        if self.seen_packets_ring.len() > 256 {
            self.seen_packets_ring.remove(0);
        }
        true
    }
}
