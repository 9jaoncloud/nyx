module std.net.mesh

// =========================================================================
// NYX SOVEREIGN MESH PROTOCOL (NSMP) - ZERO-GC AD-HOC COMMUNICATIONS ENGINE
// Native multi-bearer, cryptographic-identity addressing, self-healing mesh
// =========================================================================

pub enum MeshPacketType {
    Announce,     // Cryptographic identity beacon / neighborhood discovery
    Data,         // End-to-end payload frame
    Ack,          // Receipt acknowledgement
    RouteRequest, // Path discovery probe
    RouteReply,   // Path discovery response
    Telemetry,    // Link quality report
    KeepAlive     // Bearer liveness ping
}

pub enum BearerType {
    LoRaRadio,    // Sub-GHz long-range off-grid radio (SX1262 / SX1276)
    UdpOverlay,   // Clearnet / Internet UDP tunnel socket
    BluetoothLE,  // Short-range low-energy ad-hoc link
    RawEthernet,  // Layer-2 raw Ethernet frame
    SerialUart    // Microcontroller serial / satellite modem link
}

pub fn mesh_type_to_byte(t: MeshPacketType) -> u8 {
    if t == MeshPacketType.Announce { return 0 }
    if t == MeshPacketType.Data { return 1 }
    if t == MeshPacketType.Ack { return 2 }
    if t == MeshPacketType.RouteRequest { return 3 }
    if t == MeshPacketType.RouteReply { return 4 }
    if t == MeshPacketType.Telemetry { return 5 }
    6
}

pub fn byte_to_mesh_type(b: u8) -> MeshPacketType {
    if b == 0 { return MeshPacketType.Announce }
    if b == 1 { return MeshPacketType.Data }
    if b == 2 { return MeshPacketType.Ack }
    if b == 3 { return MeshPacketType.RouteRequest }
    if b == 4 { return MeshPacketType.RouteReply }
    if b == 5 { return MeshPacketType.Telemetry }
    MeshPacketType.KeepAlive
}

// 128-bit Sovereign Node Identifier (Dual 64-bit registers for SIMD/zero-GC speed)
pub struct NodeAddress {
    pub hi: u64,
    pub lo: u64
}

impl NodeAddress {
    pub fn new(hi: u64, lo: u64) -> NodeAddress {
        NodeAddress { hi: hi, lo: lo }
    }

    pub fn broadcast() -> NodeAddress {
        NodeAddress {
            hi: 0xFFFFFFFFFFFFFFFF,
            lo: 0xFFFFFFFFFFFFFFFF
        }
    }

    pub fn zero() -> NodeAddress {
        NodeAddress { hi: 0, lo: 0 }
    }

    pub fn is_broadcast(self: &NodeAddress) -> bool {
        self.hi == 0xFFFFFFFFFFFFFFFF && self.lo == 0xFFFFFFFFFFFFFFFF
    }

    pub fn is_equal(self: &NodeAddress, other: &NodeAddress) -> bool {
        self.hi == other.hi && self.lo == other.lo
    }

    pub fn to_hex(self: &NodeAddress) -> String {
        self.hi.to_string() + ":" + self.lo.to_string()
    }
}

// Fixed 44-byte Wire Protocol Header
pub struct MeshHeader {
    pub magic_0: u8,
    pub magic_1: u8,
    pub version: u8,
    pub packet_type: MeshPacketType,
    pub flags: u8,
    pub hop_limit: u8,
    pub hop_count: u8,
    pub reserved: u8,
    pub src_hi: u64,
    pub src_lo: u64,
    pub dst_hi: u64,
    pub dst_lo: u64,
    pub seq_num: u32,
    pub payload_len: u16,
    pub checksum: u32
}

pub struct MeshPacket {
    pub is_valid: bool,
    pub header: MeshHeader,
    pub payload: Vec<u8>,
    pub ingress_bearer: BearerType,
    pub rssi_dbm: i16,
    pub snr_db: f32
}

impl MeshPacket {
    pub fn new(src: NodeAddress, dst: NodeAddress, pkt_type: MeshPacketType, flags: u8, seq: u32, data: Vec<u8>) -> MeshPacket {
        let p_len = data.len() as u16
        MeshPacket {
            is_valid: true,
            header: MeshHeader {
                magic_0: 0x4E, // 'N'
                magic_1: 0x58, // 'X'
                version: 1,
                packet_type: pkt_type,
                flags: flags,
                hop_limit: 16,
                hop_count: 0,
                reserved: 0,
                src_hi: src.hi,
                src_lo: src.lo,
                dst_hi: dst.hi,
                dst_lo: dst.lo,
                seq_num: seq,
                payload_len: p_len,
                checksum: 0
            },
            payload: data,
            ingress_bearer: BearerType.UdpOverlay,
            rssi_dbm: 0,
            snr_db: 0.0
        }
    }

    pub fn invalid() -> MeshPacket {
        MeshPacket {
            is_valid: false,
            header: MeshHeader {
                magic_0: 0,
                magic_1: 0,
                version: 0,
                packet_type: MeshPacketType.KeepAlive,
                flags: 0,
                hop_limit: 0,
                hop_count: 0,
                reserved: 0,
                src_hi: 0,
                src_lo: 0,
                dst_hi: 0,
                dst_lo: 0,
                seq_num: 0,
                payload_len: 0,
                checksum: 0
            },
            payload: Vec.new(),
            ingress_bearer: BearerType.UdpOverlay,
            rssi_dbm: 0,
            snr_db: 0.0
        }
    }

    pub fn compute_checksum(self: &mut MeshPacket) -> u32 {
        let mut crc: u32 = 0xFFFFFFFF
        // Fold src and dst addresses
        crc = crc ^ ((self.header.src_hi >> 32) as u32)
        crc = crc ^ (self.header.src_hi as u32)
        crc = crc ^ ((self.header.src_lo >> 32) as u32)
        crc = crc ^ (self.header.src_lo as u32)
        crc = crc ^ ((self.header.dst_hi >> 32) as u32)
        crc = crc ^ (self.header.dst_hi as u32)
        crc = crc ^ ((self.header.dst_lo >> 32) as u32)
        crc = crc ^ (self.header.dst_lo as u32)
        crc = crc ^ self.header.seq_num
        crc = crc ^ (self.header.payload_len as u32)

        // Fold payload
        let mut p_idx: u64 = 0
        while p_idx < self.payload.len() {
            let b = self.payload.get(p_idx).unwrap() as u32
            crc = ((crc >> 8) ^ (crc ^ b)) & 0xFFFFFFFF
            p_idx = p_idx + 1
        }
        self.header.checksum = crc
        crc
    }

    pub fn serialize(self: &mut MeshPacket) -> Vec<u8> {
        self.compute_checksum()
        let mut wire: Vec<u8> = Vec.new()

        // 1. Magic
        wire.push(self.header.magic_0)
        wire.push(self.header.magic_1)
        // 2. Version & Type
        wire.push(self.header.version)
        let type_byte: u8 = mesh_type_to_byte(self.header.packet_type)
        wire.push(type_byte)
        // 3. Flags, Hop Limit, Hop Count, Reserved
        wire.push(self.header.flags)
        wire.push(self.header.hop_limit)
        wire.push(self.header.hop_count)
        wire.push(self.header.reserved)

        // 4. Source Address (16 bytes = 2x u64)
        let mut s_shift: i64 = 56
        while s_shift >= 0 {
            wire.push(((self.header.src_hi >> (s_shift as u64)) & 0xFF) as u8)
            s_shift = s_shift - 8
        }
        s_shift = 56
        while s_shift >= 0 {
            wire.push(((self.header.src_lo >> (s_shift as u64)) & 0xFF) as u8)
            s_shift = s_shift - 8
        }

        // 5. Destination Address (16 bytes = 2x u64)
        let mut d_shift: i64 = 56
        while d_shift >= 0 {
            wire.push(((self.header.dst_hi >> (d_shift as u64)) & 0xFF) as u8)
            d_shift = d_shift - 8
        }
        d_shift = 56
        while d_shift >= 0 {
            wire.push(((self.header.dst_lo >> (d_shift as u64)) & 0xFF) as u8)
            d_shift = d_shift - 8
        }

        // 6. Sequence Number (4 bytes)
        wire.push(((self.header.seq_num >> 24) & 0xFF) as u8)
        wire.push(((self.header.seq_num >> 16) & 0xFF) as u8)
        wire.push(((self.header.seq_num >> 8) & 0xFF) as u8)
        wire.push((self.header.seq_num & 0xFF) as u8)

        // 7. Payload Length (2 bytes)
        wire.push(((self.header.payload_len >> 8) & 0xFF) as u8)
        wire.push((self.header.payload_len & 0xFF) as u8)

        // 8. Checksum (4 bytes)
        wire.push(((self.header.checksum >> 24) & 0xFF) as u8)
        wire.push(((self.header.checksum >> 16) & 0xFF) as u8)
        wire.push(((self.header.checksum >> 8) & 0xFF) as u8)
        wire.push((self.header.checksum & 0xFF) as u8)

        // 9. Payload Data
        let mut p_idx: u64 = 0
        while p_idx < self.payload.len() {
            wire.push(self.payload.get(p_idx).unwrap())
            p_idx = p_idx + 1
        }

        wire
    }

    pub fn deserialize(raw: &Vec<u8>) -> MeshPacket {
        if raw.len() < 44 {
            return MeshPacket::invalid()
        }

        if raw.get(0).unwrap() != 0x4E || raw.get(1).unwrap() != 0x58 {
            return MeshPacket::invalid()
        }

        let ver = raw.get(2).unwrap()
        let type_raw = raw.get(3).unwrap()
        let pkt_type = byte_to_mesh_type(type_raw)

        let flags = raw.get(4).unwrap()
        let hop_limit = raw.get(5).unwrap()
        let hop_count = raw.get(6).unwrap()
        let reserved = raw.get(7).unwrap()

        // Read src_hi and src_lo
        let mut s_hi: u64 = 0
        let mut idx: u64 = 8
        while idx < 16 {
            s_hi = (s_hi << 8) | (raw.get(idx).unwrap() as u64)
            idx = idx + 1
        }
        let mut s_lo: u64 = 0
        while idx < 24 {
            s_lo = (s_lo << 8) | (raw.get(idx).unwrap() as u64)
            idx = idx + 1
        }

        // Read dst_hi and dst_lo
        let mut d_hi: u64 = 0
        while idx < 32 {
            d_hi = (d_hi << 8) | (raw.get(idx).unwrap() as u64)
            idx = idx + 1
        }
        let mut d_lo: u64 = 0
        while idx < 40 {
            d_lo = (d_lo << 8) | (raw.get(idx).unwrap() as u64)
            idx = idx + 1
        }

        let seq = ((raw.get(40).unwrap() as u32) << 24) |
                  ((raw.get(41).unwrap() as u32) << 16) |
                  ((raw.get(42).unwrap() as u32) << 8)  |
                   (raw.get(43).unwrap() as u32)

        let p_len = ((raw.get(44).unwrap() as u16) << 8) | (raw.get(45).unwrap() as u16)
        
        let mut csum: u32 = 0
        if raw.len() >= 50 {
            csum = ((raw.get(46).unwrap() as u32) << 24) |
                   ((raw.get(47).unwrap() as u32) << 16) |
                   ((raw.get(48).unwrap() as u32) << 8)  |
                    (raw.get(49).unwrap() as u32)
        }

        let mut payload_vec: Vec<u8> = Vec.new()
        let payload_offset: u64 = 50
        let mut p_idx: u64 = 0
        while (payload_offset + p_idx) < raw.len() && p_idx < (p_len as u64) {
            payload_vec.push(raw.get(payload_offset + p_idx).unwrap())
            p_idx = p_idx + 1
        }

        MeshPacket {
            is_valid: true,
            header: MeshHeader {
                magic_0: 0x4E,
                magic_1: 0x58,
                version: ver,
                packet_type: pkt_type,
                flags: flags,
                hop_limit: hop_limit,
                hop_count: hop_count,
                reserved: reserved,
                src_hi: s_hi,
                src_lo: s_lo,
                dst_hi: d_hi,
                dst_lo: d_lo,
                seq_num: seq,
                payload_len: p_len,
                checksum: csum
            },
            payload: payload_vec,
            ingress_bearer: BearerType.UdpOverlay,
            rssi_dbm: 0,
            snr_db: 0.0
        }
    }
}

// Forwarding Decision
pub enum RoutingAction {
    DeliverLocally,  // Packet destination is self or broadcast
    ForwardNextHop,  // Decrement TTL and dispatch to optimal bearer
    DropDuplicate,   // Packet already seen in ring buffer
    DropHopExceeded  // Hop limit reached 0
}

// Decentralized Sovereign Mesh Router Node (zero-GC flat parallel columns)
pub struct SovereignMeshRouter {
    pub local_hi: u64,
    pub local_lo: u64,
    pub max_hops: u8,
    pub sequence_counter: u32,
    pub route_dest_hi: Vec<u64>,
    pub route_dest_lo: Vec<u64>,
    pub route_next_hi: Vec<u64>,
    pub route_next_lo: Vec<u64>,
    pub route_hop_cost: Vec<u8>,
    pub seen_cache: Vec<u32>,
    pub total_rx_packets: u64,
    pub total_tx_packets: u64,
    pub total_forwarded_packets: u64
}

impl SovereignMeshRouter {
    pub fn new(local_addr: NodeAddress) -> SovereignMeshRouter {
        SovereignMeshRouter {
            local_hi: local_addr.hi,
            local_lo: local_addr.lo,
            max_hops: 16,
            sequence_counter: 1,
            route_dest_hi: Vec.new(),
            route_dest_lo: Vec.new(),
            route_next_hi: Vec.new(),
            route_next_lo: Vec.new(),
            route_hop_cost: Vec.new(),
            seen_cache: Vec.new(),
            total_rx_packets: 0,
            total_tx_packets: 0,
            total_forwarded_packets: 0
        }
    }

    pub fn next_sequence(self: &mut SovereignMeshRouter) -> u32 {
        let seq = self.sequence_counter
        self.sequence_counter = self.sequence_counter + 1
        seq
    }

    // Ingress packet processing with anti-replay hash check and gradient routing
    pub fn process_ingress(self: &mut SovereignMeshRouter, packet: &mut MeshPacket) -> RoutingAction {
        self.total_rx_packets = self.total_rx_packets + 1

        // 1. Check Anti-Replay Ring Buffer
        let packet_id_hash = (packet.header.src_hi as u32) ^
                             (packet.header.src_lo as u32) ^
                             packet.header.seq_num

        let slot = (packet_id_hash & 511) as u64
        while self.seen_cache.len() <= slot {
            self.seen_cache.push(0)
        }
        if self.seen_cache.get(slot).unwrap() == packet_id_hash {
            return RoutingAction.DropDuplicate
        }
        self.seen_cache.set(slot, packet_id_hash)

        // 2. Opportunistic Route Discovery (Reverse Path Learning)
        let src_node = NodeAddress::new(packet.header.src_hi, packet.header.src_lo)
        self.learn_route(src_node, src_node, packet.header.hop_count + 1)

        // 3. Local Delivery Check
        let dst_node = NodeAddress::new(packet.header.dst_hi, packet.header.dst_lo)
        let self_node = NodeAddress::new(self.local_hi, self.local_lo)
        if dst_node.is_equal(&self_node) || dst_node.is_broadcast() {
            return RoutingAction.DeliverLocally
        }

        // 4. Hop Limit Check
        if packet.header.hop_limit <= 1 {
            return RoutingAction.DropHopExceeded
        }

        // 5. Multi-Hop Forwarding Preparation
        packet.header.hop_limit = packet.header.hop_limit - 1
        packet.header.hop_count = packet.header.hop_count + 1
        self.total_forwarded_packets = self.total_forwarded_packets + 1

        RoutingAction.ForwardNextHop
    }

    // Dynamic Route Learning
    pub fn learn_route(self: &mut SovereignMeshRouter, dest: NodeAddress, next_hop: NodeAddress, hops: u8) {
        let mut r_idx: u64 = 0
        let mut found = false
        while r_idx < self.route_dest_hi.len() {
            if self.route_dest_hi.get(r_idx).unwrap() == dest.hi &&
               self.route_dest_lo.get(r_idx).unwrap() == dest.lo {
                found = true
                break
            }
            r_idx = r_idx + 1
        }

        if !found {
            self.route_dest_hi.push(dest.hi)
            self.route_dest_lo.push(dest.lo)
            self.route_next_hi.push(next_hop.hi)
            self.route_next_lo.push(next_hop.lo)
            self.route_hop_cost.push(hops)
        }
    }

    // Lookup optimal route cost for destination
    pub fn get_route_cost(self: &SovereignMeshRouter, dest: &NodeAddress) -> i32 {
        let mut r_idx: u64 = 0
        while r_idx < self.route_dest_hi.len() {
            if self.route_dest_hi.get(r_idx).unwrap() == dest.hi &&
               self.route_dest_lo.get(r_idx).unwrap() == dest.lo {
                return self.route_hop_cost.get(r_idx).unwrap() as i32
            }
            r_idx = r_idx + 1
        }
        -1
    }

    // Create outbound data packet addressed to sovereign cryptographic ID
    pub fn create_data_packet(self: &mut SovereignMeshRouter, dest: NodeAddress, payload: Vec<u8>) -> MeshPacket {
        let seq = self.next_sequence()
        let flags: u8 = if dest.is_broadcast() { 4 } else { 3 } // 4 = Broadcast, 3 = Encrypted | Ack
        self.total_tx_packets = self.total_tx_packets + 1
        let self_node = NodeAddress::new(self.local_hi, self.local_lo)
        MeshPacket::new(self_node, dest, MeshPacketType.Data, flags, seq, payload)
    }

    // Create discovery announce beacon
    pub fn create_announce_beacon(self: &mut SovereignMeshRouter) -> MeshPacket {
        let seq = self.next_sequence()
        let mut announce_data: Vec<u8> = Vec.new()
        announce_data.push(1) // Capability: Mesh Forwarder
        announce_data.push(1) // Multi-bearer supported
        let self_node = NodeAddress::new(self.local_hi, self.local_lo)
        MeshPacket::new(self_node, NodeAddress::broadcast(), MeshPacketType.Announce, 4, seq, announce_data)
    }
}
