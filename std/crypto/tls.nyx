// Nyx Standard Library — @nyx/crypto/tls
// Production-Grade TLS 1.3 / OpenSSL & mbedTLS Native Bridge

module std.crypto.tls

extern "C" {
    fn nyx_tls_connect(hostname: *const u8, port: i32, alpn_protocols: *const u8) -> *mut u8
    fn nyx_tls_close(session: *mut u8)
    fn nyx_tls_write(session: *mut u8, data: *const u8, len: usize) -> i32
    fn nyx_tls_read(session: *mut u8, buf: *mut u8, max_len: usize) -> i32
}

pub struct TlsSocket {
    handle: *mut u8,
    pub is_connected: bool,
}

impl TlsSocket {
    pub fn connect(host: String, port: i32, alpn: String) -> Option<TlsSocket> {
        let ptr = nyx_tls_connect(host.as_ptr(), port, alpn.as_ptr());
        if ptr == null {
            return Option.None;
        }
        Option.Some(TlsSocket {
            handle: ptr,
            is_connected: true,
        })
    }

    pub fn close(self: &mut TlsSocket) {
        if self.handle != null {
            nyx_tls_close(self.handle);
            self.handle = null;
            self.is_connected = false;
        }
    }
}
