// Nyx Standard Library — std.event_vision & std.cochlea
// Neuromorphic DVS event-camera streams & Silicon Cochlea acoustic filterbanks.

module event_vision

import prelude.*

pub struct VisionEvent {
    pub x: u16,
    pub y: u16,
    pub timestamp_us: u32,
    pub polarity: i8,
}

pub struct EventCameraSensor {
    pub width: u16,
    pub height: u16,
    pub total_events: u32,
}

impl EventCameraSensor {
    pub fn new(width: u16, height: u16) -> EventCameraSensor {
        EventCameraSensor {
            width: width,
            height: height,
            total_events: 0 as u32,
        }
    }

    pub fn process_batch(self: &mut EventCameraSensor, events: Vec<VisionEvent>) {
        self.total_events = self.total_events + (events.len() as u32)
    }

    pub fn get_total_events(self: &EventCameraSensor) -> u32 {
        self.total_events
    }
}
