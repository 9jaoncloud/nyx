module std.os.kernel

import std.embedded.hardware
import std.io

// =========================================================================
// NYX SOVEREIGN BARE-METAL OPERATING SYSTEM KERNEL
// Memory Paging, Preemptive Task Scheduler, Direct Linear Framebuffer GUI
// =========================================================================

pub struct LinearFramebuffer {
    pub base_addr: u64,
    pub width: u32,
    pub height: u32,
    pub pitch: u32,
    pub bpp: u8
}

impl LinearFramebuffer {
    pub fn new(addr: u64, w: u32, h: u32, pitch: u32, bpp: u8) -> LinearFramebuffer {
        LinearFramebuffer {
            base_addr: addr,
            width: w,
            height: h,
            pitch: pitch,
            bpp: bpp
        }
    }

    pub fn draw_pixel(self: &LinearFramebuffer, x: u32, y: u32, color_argb: u32) {
        if x >= self.width || y >= self.height { return; }
        let offset = (y as u64 * self.pitch as u64) + (x as u64 * (self.bpp as u64 / 8));
        unsafe {
            let ptr = (self.base_addr + offset) as *mut u32;
            *ptr = color_argb;
        }
    }

    pub fn fill_rect(self: &LinearFramebuffer, x: u32, y: u32, w: u32, h: u32, color_argb: u32) {
        for dy in 0..h {
            for dx in 0..w {
                self.draw_pixel(x + dx, y + dy, color_argb);
            }
        }
    }
}

pub struct OSWindow {
    pub id: u32,
    pub title: String,
    pub x: u32,
    pub y: u32,
    pub width: u32,
    pub height: u32,
    pub is_focused: bool
}

impl OSWindow {
    pub fn render(self: &OSWindow, fb: &LinearFramebuffer) {
        // Window Title Bar
        let title_color = if self.is_focused { 0xFF1E293B } else { 0xFF0F172A };
        fb.fill_rect(self.x, self.y, self.width, 28, title_color);
        
        // Window Body (Modern Dark Slate)
        fb.fill_rect(self.x, self.y + 28, self.width, self.height - 28, 0xFF0B0F19);
        
        // Window Border Highlight
        fb.fill_rect(self.x, self.y, self.width, 1, 0xFF38BDF8);
    }
}

pub enum TaskState {
    Ready,
    Running,
    Blocked,
    Terminated
}

pub struct KernelTask {
    pub task_id: u32,
    pub name: String,
    pub priority: u8,
    pub state: TaskState,
    pub stack_pointer: u64,
    pub region_base: u64,
    pub cpu_time_ticks: u64
}

pub struct SovereignKernel {
    pub memory_total_mb: u32,
    pub tasks: Vec<KernelTask>,
    pub active_task_idx: usize,
    pub compositor_fb: LinearFramebuffer
}

impl SovereignKernel {
    pub fn boot(fb_addr: u64, w: u32, h: u32) -> SovereignKernel {
        let fb = LinearFramebuffer.new(fb_addr, w, h, w * 4, 32);
        // Clear screen with deep OLED black
        fb.fill_rect(0, 0, w, h, 0xFF030712);
        
        SovereignKernel {
            memory_total_mb: 2048,
            tasks: Vec.new(),
            active_task_idx: 0,
            compositor_fb: fb
        }
    }

    pub fn spawn_task(self: &mut SovereignKernel, name: String, prio: u8, stack_top: u64) -> u32 {
        let id = (self.tasks.len() + 1) as u32;
        let task = KernelTask {
            task_id: id,
            name: name,
            priority: prio,
            state: TaskState.Ready,
            stack_pointer: stack_top,
            region_base: stack_top - 0x100000,
            cpu_time_ticks: 0
        };
        self.tasks.push(task);
        id
    }

    pub fn schedule_quantum(self: &mut SovereignKernel) -> u32 {
        if self.tasks.len() == 0 { return 0; }
        
        self.tasks[self.active_task_idx].cpu_time_ticks += 1;
        self.active_task_idx = (self.active_task_idx + 1) % self.tasks.len();
        self.tasks[self.active_task_idx].state = TaskState.Running;
        self.tasks[self.active_task_idx].task_id
    }
}
