module option

pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    pub fn is_some(self: &Option<T>) -> Bool {
        match self { Option.Some(_) => true, Option.None => false }
    }

    pub fn is_none(self: &Option<T>) -> Bool {
        match self { Option.None => true, _ => false }
    }

    pub fn unwrap(self: Option<T>) -> T {
        match self {
            Option.Some(v) => v,
            Option.None => panic("unwrap called on None"),
        }
    }

    pub fn unwrap_or(self: Option<T>, default: T) -> T {
        match self {
            Option.Some(v) => v,
            Option.None => default,
        }
    }
}
