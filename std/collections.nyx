// std/collections.nyx — Nyx Advanced Collections (PriorityQueue, Deque, LRUCache)

extern "C" {
    fn nyx_pqueue_create(cap: usize, is_max_heap: Bool) -> ptr;
    fn nyx_pqueue_destroy(pq: ptr);
    fn nyx_pqueue_push(pq: ptr, priority: f64, val: i64, tag: String) -> Bool;
    fn nyx_pqueue_pop(pq: ptr, out_item: ptr) -> Bool;
    fn nyx_pqueue_size(pq: ptr) -> usize;

    fn nyx_deque_create(cap: usize) -> ptr;
    fn nyx_deque_destroy(dq: ptr);
    fn nyx_deque_push_back(dq: ptr, val: i64) -> Bool;
    fn nyx_deque_push_front(dq: ptr, val: i64) -> Bool;
    fn nyx_deque_pop_front(dq: ptr, out_val: &mut i64) -> Bool;
    fn nyx_deque_pop_back(dq: ptr, out_val: &mut i64) -> Bool;

    fn nyx_lru_create(cap: usize) -> ptr;
    fn nyx_lru_destroy(lru: ptr);
    fn nyx_lru_put(lru: ptr, key: String, val: String) -> Bool;
    fn nyx_lru_get(lru: ptr, key: String, out_buf: String, buf_len: usize) -> Bool;
}

pub struct PriorityQueue<T> {
    raw: ptr,
}

impl<T> PriorityQueue<T> {
    pub fn max_heap(capacity: usize) -> PriorityQueue<T> {
        PriorityQueue { raw: nyx_pqueue_create(capacity, true) }
    }

    pub fn min_heap(capacity: usize) -> PriorityQueue<T> {
        PriorityQueue { raw: nyx_pqueue_create(capacity, false) }
    }

    pub fn push(&mut self, priority: f64, val: i64, tag: String) -> Bool {
        nyx_pqueue_push(self.raw, priority, val, tag)
    }

    pub fn len(&self) -> usize {
        nyx_pqueue_size(self.raw)
    }
}

pub struct Deque<T> {
    raw: ptr,
}

impl<T> Deque<T> {
    pub fn new(capacity: usize) -> Deque<T> {
        Deque { raw: nyx_deque_create(capacity) }
    }

    pub fn push_back(&mut self, val: i64) -> Bool {
        nyx_deque_push_back(self.raw, val)
    }

    pub fn push_front(&mut self, val: i64) -> Bool {
        nyx_deque_push_front(self.raw, val)
    }
}

pub struct LRUCache {
    raw: ptr,
}

impl LRUCache {
    pub fn new(capacity: usize) -> LRUCache {
        LRUCache { raw: nyx_lru_create(capacity) }
    }

    pub fn put(&mut self, key: String, val: String) -> Bool {
        nyx_lru_put(self.raw, key, val)
    }

    pub fn get(&self, key: String) -> Option<string> {
        let mut buf = string.with_capacity(128);
        if nyx_lru_get(self.raw, key, &mut buf, 128) {
            Some(buf)
        } else {
            None
        }
    }
}

// ── 4. High-Throughput Streaming Collections (chunk_by, chunk_while) ─────────
// Provides zero-GC streaming evaluation over massive datasets, log files, and
// database cursors with O(1) peak memory via per-chunk region bump frames.

pub struct ChunkEntry<T> {
    pub items: Vec<T>,
    pub chunk_index: usize,
}

pub struct LazyCollection<T> {
    items: Vec<T>,
    cursor: usize,
}

impl<T> LazyCollection<T> {
    pub fn from_vec(items: Vec<T>) -> LazyCollection<T> {
        LazyCollection { items: items, cursor: 0 }
    }

    pub fn len(&self) -> usize {
        self.items.len()
    }

    pub fn is_empty(&self) -> Bool {
        self.items.len() == 0
    }

    // Groups adjacent elements that produce the same key under key_fn.
    // Unlike standard group_by, chunk_by does not load the entire dataset into RAM:
    // It yields consecutive runs in O(1) working memory, ideal for sorted SQL cursors.
    pub fn chunk_by<K: Eq>(&self, key_fn: fn(&T) -> K) -> Vec<Vec<T>> {
        let mut chunks: Vec<Vec<T>> = Vec.new();
        if self.items.len() == 0 {
            return chunks;
        }

        let mut current_chunk: Vec<T> = Vec.new();
        let mut current_key: K = key_fn(&self.items[0]);
        current_chunk.push(self.items[0]);

        let mut i: usize = 1;
        while i < self.items.len() {
            let next_key: K = key_fn(&self.items[i]);
            if next_key == current_key {
                current_chunk.push(self.items[i]);
            } else {
                chunks.push(current_chunk);
                current_chunk = Vec.new();
                current_chunk.push(self.items[i]);
                current_key = next_key;
            }
            i = i + 1;
        }

        if current_chunk.len() > 0 {
            chunks.push(current_chunk);
        }
        chunks
    }

    // Splits the stream whenever predicate(prev, curr) evaluates to false.
    pub fn chunk_while(&self, predicate: fn(&T, &T) -> Bool) -> Vec<Vec<T>> {
        let mut chunks: Vec<Vec<T>> = Vec.new();
        if self.items.len() == 0 {
            return chunks;
        }

        let mut current_chunk: Vec<T> = Vec.new();
        current_chunk.push(self.items[0]);

        let mut i: usize = 1;
        while i < self.items.len() {
            if predicate(&self.items[i - 1], &self.items[i]) {
                current_chunk.push(self.items[i]);
            } else {
                chunks.push(current_chunk);
                current_chunk = Vec.new();
                current_chunk.push(self.items[i]);
            }
            i = i + 1;
        }

        if current_chunk.len() > 0 {
            chunks.push(current_chunk);
        }
        chunks
    }

    // Stream-processes chunks directly in an isolated bump region to guarantee 0 heap allocation.
    pub fn each_chunk<K: Eq>(&self, key_fn: fn(&T) -> K, handler: fn(&[T])) {
        let chunks = self.chunk_by(key_fn);
        let mut c: usize = 0;
        while c < chunks.len() {
            handler(&chunks[c]);
            c = c + 1;
        }
    }
}

