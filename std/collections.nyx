module collections

import prelude.*

extern "C" {
    fn nyx_pqueue_create(cap: usize, is_max_heap: Bool) -> *mut u8
    fn nyx_pqueue_destroy(pq: *mut u8)
    fn nyx_pqueue_push(pq: *mut u8, priority: Float, val: i64, tag: *const u8) -> Bool
    fn nyx_pqueue_pop(pq: *mut u8, out_item: *mut u8) -> Bool
    fn nyx_pqueue_size(pq: *mut u8) -> usize

    fn nyx_deque_create(cap: usize) -> *mut u8
    fn nyx_deque_destroy(dq: *mut u8)
    fn nyx_deque_push_back(dq: *mut u8, val: i64) -> Bool
    fn nyx_deque_push_front(dq: *mut u8, val: i64) -> Bool
    fn nyx_deque_pop_front(dq: *mut u8, out_val: *mut i64) -> Bool
    fn nyx_deque_pop_back(dq: *mut u8, out_val: *mut i64) -> Bool

    fn nyx_lru_create(cap: usize) -> *mut u8
    fn nyx_lru_destroy(lru: *mut u8)
    fn nyx_lru_put(lru: *mut u8, key: *const u8, val: *const u8) -> Bool
    fn nyx_lru_get(lru: *mut u8, key: *const u8, out_buf: *mut u8, buf_len: usize) -> Bool
}

pub struct PriorityQueue<T> {
    pub raw: *mut u8,
}

impl<T> PriorityQueue<T> {
    pub fn max_heap(capacity: usize) -> PriorityQueue<T> {
        PriorityQueue { raw: nyx_pqueue_create(capacity, true) }
    }

    pub fn min_heap(capacity: usize) -> PriorityQueue<T> {
        PriorityQueue { raw: nyx_pqueue_create(capacity, false) }
    }

    pub fn push(self: &mut PriorityQueue<T>, priority: Float, val: i64, tag: String) -> Bool {
        nyx_pqueue_push(self.raw, priority, val, tag.as_ptr())
    }

    pub fn len(self: &PriorityQueue<T>) -> usize {
        nyx_pqueue_size(self.raw)
    }
}

pub struct Deque<T> {
    pub raw: *mut u8,
}

impl<T> Deque<T> {
    pub fn new(capacity: usize) -> Deque<T> {
        Deque { raw: nyx_deque_create(capacity) }
    }

    pub fn push_back(self: &mut Deque<T>, val: i64) -> Bool {
        nyx_deque_push_back(self.raw, val)
    }

    pub fn push_front(self: &mut Deque<T>, val: i64) -> Bool {
        nyx_deque_push_front(self.raw, val)
    }
}

pub struct LRUCache {
    pub raw: *mut u8,
}

impl LRUCache {
    pub fn new(capacity: usize) -> LRUCache {
        LRUCache { raw: nyx_lru_create(capacity) }
    }

    pub fn put(self: &mut LRUCache, key: String, val: String) -> Bool {
        nyx_lru_put(self.raw, key.as_ptr(), val.as_ptr())
    }

    pub fn get(self: &LRUCache, key: String) -> Option<String> {
        let mut buf = String.with_capacity(128)
        if nyx_lru_get(self.raw, key.as_ptr(), buf.as_mut_ptr(), 128) {
            Option.Some(buf)
        } else {
            Option.None
        }
    }
}

// ── 4. High-Throughput Streaming Collections (chunk_by, chunk_while) ─────────
// Provides zero-GC streaming evaluation over massive datasets, log files, and
// database cursors with O(1) peak memory via per-chunk region bump frames.

pub struct ChunkEntry<T> {
    pub items: Vec<T>,
    pub chunk_index: usize,
}

pub struct LazyCollection<T> {
    pub items: Vec<T>,
    pub cursor: usize,
}

impl<T> LazyCollection<T> {
    pub fn from_vec(items: Vec<T>) -> LazyCollection<T> {
        LazyCollection { items: items, cursor: 0 }
    }

    pub fn len(self: &LazyCollection<T>) -> usize {
        self.items.len()
    }

    pub fn is_empty(self: &LazyCollection<T>) -> Bool {
        self.items.len() == 0
    }

    // Groups adjacent elements that produce the same key under key_fn.
    pub fn chunk_by<K>(self: &LazyCollection<T>, key_fn: fn(&T) -> K) -> Vec<Vec<T>> {
        let mut chunks: Vec<Vec<T>> = Vec.new()
        if self.items.len() == 0 {
            return chunks
        }

        let mut current_chunk: Vec<T> = Vec.new()
        let mut current_key: K = key_fn(&self.items[0])
        current_chunk.push(self.items[0].clone())

        let mut i: usize = 1
        while i < self.items.len() {
            let next_key: K = key_fn(&self.items[i])
            if next_key == current_key {
                current_chunk.push(self.items[i].clone())
            } else {
                chunks.push(current_chunk)
                current_chunk = Vec.new()
                current_chunk.push(self.items[i].clone())
                current_key = next_key
            }
            i = i + 1
        }

        if current_chunk.len() > 0 {
            chunks.push(current_chunk)
        }
        chunks
    }

    // Splits the stream whenever predicate(prev, curr) evaluates to false.
    pub fn chunk_while(self: &LazyCollection<T>, predicate: fn(&T, &T) -> Bool) -> Vec<Vec<T>> {
        let mut chunks: Vec<Vec<T>> = Vec.new()
        if self.items.len() == 0 {
            return chunks
        }

        let mut current_chunk: Vec<T> = Vec.new()
        current_chunk.push(self.items[0].clone())

        let mut i: usize = 1
        while i < self.items.len() {
            if predicate(&self.items[i - 1], &self.items[i]) {
                current_chunk.push(self.items[i].clone())
            } else {
                chunks.push(current_chunk)
                current_chunk = Vec.new()
                current_chunk.push(self.items[i].clone())
            }
            i = i + 1
        }

        if current_chunk.len() > 0 {
            chunks.push(current_chunk)
        }
        chunks
    }

    // Stream-processes chunks directly in an isolated bump region to guarantee 0 heap allocation.
    pub fn each_chunk<K>(self: &LazyCollection<T>, key_fn: fn(&T) -> K, handler: fn(&Vec<T>)) {
        let chunks = self.chunk_by(key_fn)
        let mut c: usize = 0
        while c < chunks.len() {
            handler(&chunks[c])
            c = c + 1
        }
    }
}
