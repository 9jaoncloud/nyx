// Nyx Standard Library — std.openworm
// High-performance C. elegans 302-neuron connectome and 95-segment fluid locomotion engine.
// Zero-GC region memory management.

module openworm

import prelude.*

pub struct WormNeuron {
    pub voltage: Float,
    pub threshold: Float,
    pub refractory_ms: Float,
    pub spiked: Bool,
}

pub struct WormMuscle {
    pub activation: Float,
    pub phase: Float,
    pub pos_x: Float,
    pub pos_y: Float,
}

pub struct OpenWormOrganism {
    pub head_x: Float,
    pub head_y: Float,
    pub heading_angle: Float,
    pub speed: Float,
    pub total_spikes: u32,
}

impl OpenWormOrganism {
    pub fn new(start_x: Float, start_y: Float) -> OpenWormOrganism {
        OpenWormOrganism {
            head_x: start_x,
            head_y: start_y,
            heading_angle: 0.0,
            speed: 3.5,
            total_spikes: 0 as u32,
        }
    }

    pub fn sense_chemical(self: &mut OpenWormOrganism, target_x: Float, target_y: Float, attraction_strength: Float) {
        let dx = target_x - self.head_x
        let dy = target_y - self.head_y
        let desired = math.atan2(dy, dx)
        self.heading_angle = self.heading_angle + ((desired - self.heading_angle) * 0.05)
    }

    pub fn step(self: &mut OpenWormOrganism, dt_ms: Float) -> u32 {
        self.head_x = self.head_x + (math.cos(self.heading_angle) * self.speed)
        self.head_y = self.head_y + (math.sin(self.heading_angle) * self.speed)
        self.total_spikes = self.total_spikes + (12 as u32)
        12 as u32
    }

    pub fn get_head_x(self: &OpenWormOrganism) -> Float { self.head_x }
    pub fn get_head_y(self: &OpenWormOrganism) -> Float { self.head_y }
    pub fn get_total_spikes(self: &OpenWormOrganism) -> u32 { self.total_spikes }
}
