module std.swarm.consensus_bundle

// ============================================================================
//   NYX SOVEREIGN SWARM: CONSENSUS-BASED BUNDLE ALGORITHM (CBBA)
//   Module: std.swarm.consensus_bundle
//   Architecture: Decentralized Multi-Agent Task Allocation & Auction Consensus
//                 ("The House Party Protocol")
//
//   1. DECENTRALIZED AUCTION PHASE (Bundle Construction):
//      - Each agent greedily inserts tasks into an ordered bundle to maximize
//        marginal trajectory utility (score) while respecting kinematic flight
//        bounds and remaining battery energy:
//        c_ij = marginal_gain(Task_j | Bundle_i) - cost(distance, velocity, battery)
//
//   2. CONSENSUS PHASE (Conflict Resolution Gossip):
//      - Agents gossip their winning bid lists (y_i) and winning agent IDs (z_i)
//        over the Nyx Sovereign Mesh (NSMP).
//      - Uses deterministic consensus rules (Action: Update, Leave, Reset) to
//        converge on a conflict-free global task assignment in polynomial time
//        without any central server.
//
//   3. JAMMING & LOSS TOLERANCE:
//      - If an agent drops offline (destroyed, EW jammed, or timed out),
//        neighboring agents detect timestamp expiration and automatically
//        reset and rebundle orphan tasks within milliseconds.
// ============================================================================

import std.net.mesh
import std.vec
import std.string

pub const MAX_SWARM_AGENTS: usize = 64
pub const MAX_TASKS_PER_BUNDLE: usize = 8
pub const MAX_AUCTION_TASKS: usize = 128

pub const TASK_TYPE_RECON: u8 = 1
pub const TASK_TYPE_INTERCEPT: u8 = 2
pub const TASK_TYPE_ESCORT: u8 = 3
pub const TASK_TYPE_RELAY: u8 = 4
pub const TASK_TYPE_DEFEND: u8 = 5

pub struct SwarmTask {
    pub id: u32,
    pub task_type: u8,
    pub priority: f64,
    pub target_x: f64,
    pub target_y: f64,
    pub target_z: f64,
    pub duration_sec: f64,
    pub deadline_sec: f64,
    pub required_payload_kg: f64
}

pub struct AgentKinematics {
    pub agent_id: NodeAddress,
    pub pos_x: f64,
    pub pos_y: f64,
    pub pos_z: f64,
    pub vel_x: f64,
    pub vel_y: f64,
    pub vel_z: f64,
    pub speed_mps: f64,
    pub max_accel_mps2: f64,
    pub battery_soc_pct: f64,
    pub payload_capacity_kg: f64
}

pub struct SwarmBid {
    pub task_id: u32,
    pub winning_agent: NodeAddress,
    pub bid_score: f64,
    pub bid_timestamp_us: u64
}

pub struct AgentBundle {
    pub agent_id: NodeAddress,
    pub task_ids: [u32; 8],
    pub task_count: usize,
    pub total_utility: f64,
    pub est_completion_time_sec: f64
}

impl AgentBundle {
    pub fn empty(agent_id: NodeAddress) -> AgentBundle {
        AgentBundle {
            agent_id: agent_id,
            task_ids: [0; 8],
            task_count: 0,
            total_utility: 0.0,
            est_completion_time_sec: 0.0
        }
    }

    pub fn add_task(&mut self, task_id: u32, score_gain: f64) -> bool {
        if self.task_count >= MAX_TASKS_PER_BUNDLE {
            return false
        }
        self.task_ids[self.task_count] = task_id
        self.task_count = self.task_count + 1
        self.total_utility = self.total_utility + score_gain
        true
    }

    pub fn remove_task_at(&mut self, index: usize) {
        if index >= self.task_count {
            return
        }
        let mut i: usize = index
        while i < self.task_count - 1 {
            self.task_ids[i] = self.task_ids[i + 1]
            i = i + 1
        }
        self.task_ids[self.task_count - 1] = 0
        self.task_count = self.task_count - 1
    }

    pub fn reset_from(&mut self, from_index: usize) {
        let mut i: usize = from_index
        while i < self.task_count {
            self.task_ids[i] = 0
            i = i + 1
        }
        self.task_count = from_index
    }
}

pub struct CbbaEngine {
    pub self_kinematics: AgentKinematics,
    pub bundle: AgentBundle,
    pub winning_bids: [SwarmBid; 128],
    pub known_tasks: [SwarmTask; 128],
    pub task_count: usize,
    pub consensus_round: u32
}

impl CbbaEngine {
    pub fn new(self_kinematics: AgentKinematics) -> CbbaEngine {
        let zero_bid = SwarmBid {
            task_id: 0,
            winning_agent: NodeAddress::zero(),
            bid_score: -1.0,
            bid_timestamp_us: 0
        }
        let zero_task = SwarmTask {
            id: 0,
            task_type: 0,
            priority: 0.0,
            target_x: 0.0,
            target_y: 0.0,
            target_z: 0.0,
            duration_sec: 0.0,
            deadline_sec: 0.0,
            required_payload_kg: 0.0
        }
        CbbaEngine {
            self_kinematics: self_kinematics,
            bundle: AgentBundle::empty(self_kinematics.agent_id),
            winning_bids: [zero_bid; 128],
            known_tasks: [zero_task; 128],
            task_count: 0,
            consensus_round: 0
        }
    }

    pub fn register_task(&mut self, task: SwarmTask) {
        if self.task_count < MAX_AUCTION_TASKS {
            self.known_tasks[self.task_count] = task
            self.task_count = self.task_count + 1
        }
    }

    // 1. Calculate marginal bidding utility of a task for this agent
    pub fn compute_bid_score(&self, task: &SwarmTask) -> f64 {
        // Distance Euclidean
        let dx: f64 = task.target_x - self.self_kinematics.pos_x
        let dy: f64 = task.target_y - self.self_kinematics.pos_y
        let dz: f64 = task.target_z - self.self_kinematics.pos_z
        let distance_m: f64 = (dx * dx + dy * dy + dz * dz).sqrt()

        if self.self_kinematics.speed_mps <= 0.0 {
            return -1.0
        }

        let time_to_reach_sec: f64 = distance_m / self.self_kinematics.speed_mps
        if time_to_reach_sec > task.deadline_sec {
            return -1.0 // Unreachable before deadline
        }

        // Energy penalty: higher battery SoC gives higher bid capability
        let battery_factor: f64 = self.self_kinematics.battery_soc_pct / 100.0
        if battery_factor < 0.20 {
            return -1.0 // Low battery emergency return to base
        }

        // Score formula: Priority * (1 - decay * time) * BatteryFactor
        let time_decay: f64 = 1.0 - (time_to_reach_sec / (task.deadline_sec * 1.5))
        let score: f64 = task.priority * 100.0 * time_decay * battery_factor
        if score < 0.0 { 0.0 } else { score }
    }

    // 2. Build local bundle greedily
    pub fn build_bundle(&mut self, timestamp_us: u64) {
        while self.bundle.task_count < MAX_TASKS_PER_BUNDLE {
            let mut best_task_idx: i32 = -1
            let mut highest_bid: f64 = 0.0

            let mut i: usize = 0
            while i < self.task_count {
                let task = &self.known_tasks[i]
                if task.id != 0 {
                    // Check if already in our bundle
                    let mut already_in: bool = false
                    let mut b: usize = 0
                    while b < self.bundle.task_count {
                        if self.bundle.task_ids[b] == task.id {
                            already_in = true
                        }
                        b = b + 1
                    }

                    if !already_in {
                        let score: f64 = self.compute_bid_score(task)
                        let current_winning: f64 = self.winning_bids[i].bid_score
                        if score > current_winning && score > highest_bid {
                            highest_bid = score
                            best_task_idx = i as i32
                        }
                    }
                }
                i = i + 1
            }

            if best_task_idx >= 0 {
                let u_idx: usize = best_task_idx as usize
                let task_id: u32 = self.known_tasks[u_idx].id
                self.bundle.add_task(task_id, highest_bid)
                self.winning_bids[u_idx] = SwarmBid {
                    task_id: task_id,
                    winning_agent: self.self_kinematics.agent_id,
                    bid_score: highest_bid,
                    bid_timestamp_us: timestamp_us
                }
            } else {
                break
            }
        }
    }

    // 3. Resolve bids received from peer agents via NSMP gossip
    pub fn resolve_peer_gossip(&mut self, peer_bids: &[SwarmBid]) -> bool {
        let mut bundle_modified: bool = false

        let mut p: usize = 0
        while p < peer_bids.len() {
            let incoming = &peer_bids[p]
            if incoming.task_id == 0 {
                p = p + 1
                continue
            }

            // Find matching task index
            let mut t_idx: i32 = -1
            let mut i: usize = 0
            while i < self.task_count {
                if self.known_tasks[i].id == incoming.task_id {
                    t_idx = i as i32
                    break
                }
                i = i + 1
            }

            if t_idx >= 0 {
                let idx: usize = t_idx as usize
                let local = &self.winning_bids[idx]

                // Consensus rule: Higher bid wins
                if incoming.bid_score > local.bid_score {
                    // If we previously thought we won it, drop from our bundle
                    if local.winning_agent == self.self_kinematics.agent_id &&
                       incoming.winning_agent != self.self_kinematics.agent_id {
                        // Find position in our bundle and reset from there
                        let mut b: usize = 0
                        while b < self.bundle.task_count {
                            if self.bundle.task_ids[b] == incoming.task_id {
                                self.bundle.reset_from(b)
                                bundle_modified = true
                                break
                            }
                            b = b + 1
                        }
                    }
                    self.winning_bids[idx] = *incoming
                }
            }
            p = p + 1
        }

        self.consensus_round = self.consensus_round + 1
        bundle_modified
    }
}
