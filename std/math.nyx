pub const PI: Float = 3.141592653589793
pub const E: Float = 2.718281828459045
pub const TAU: Float = 6.283185307179586
pub const SQRT2: Float = 1.4142135623730951
pub const LN2: Float = 0.6931471805599453
pub const INFINITY: Float = 1.0 / 0.0
pub const NAN: Float = 0.0 / 0.0

pub const INT_MAX: Int = 9223372036854775807
pub const INT_MIN: Int = -9223372036854775808

pub fn abs_int(x: Int) -> Int { if x < 0 { -x } else { x } }
pub fn abs(x: Float) -> Float { unsafe { fabs(x) } }
pub fn max(a: Float, b: Float) -> Float { if a > b { a } else { b } }
pub fn min(a: Float, b: Float) -> Float { if a < b { a } else { b } }
pub fn max_int(a: Int, b: Int) -> Int { if a > b { a } else { b } }
pub fn min_int(a: Int, b: Int) -> Int { if a < b { a } else { b } }
pub fn clamp(x: Float, lo: Float, hi: Float) -> Float { max(lo, min(x, hi)) }
pub fn clamp_int(x: Int, lo: Int, hi: Int) -> Int { max_int(lo, min_int(x, hi)) }

pub fn sqrt(x: Float) -> Float { unsafe { sqrt(x) } }
pub fn pow(base: Float, exp: Float) -> Float { unsafe { pow(base, exp) } }
pub fn sin(x: Float) -> Float { unsafe { sin(x) } }
pub fn cos(x: Float) -> Float { unsafe { cos(x) } }
