// ============================================================================
// Module: std.ai.snn_event
// Package: @nyx/neuromorphic
// Description: Asynchronous Event-Driven Spiking Neural Network (SNN)
//              Leaky Integrate-and-Fire (LIF) with STDP Synaptic Plasticity
// Author: Simeon Bala (9jaonCloud Engineering)
// Architecture: Lock-Free SPSC Spike Event Ring Buffers, Microsecond Timers
// ============================================================================

module std.ai.snn_event;

import std.core.arena;
import std.math;

// ----------------------------------------------------------------------------
// Biological Neuron Biophysical Parameters
// ----------------------------------------------------------------------------
pub struct LifNeuronParams {
    pub membrane_time_constant_ms: f64, // tau_m (typically 20.0 ms)
    pub resting_potential_mv: f64,       // V_rest (-70.0 mV)
    pub reset_potential_mv: f64,         // V_reset (-75.0 mV)
    pub threshold_potential_mv: f64,     // V_th (-55.0 mV)
    pub refractory_period_ms: f64,       // t_ref (2.0 ms)
    pub membrane_resistance_mohm: f64,   // R_m (10.0 MOhm)
}

// ----------------------------------------------------------------------------
// Discrete Spike Event Dispatched Across Neuromorphic Bus
// ----------------------------------------------------------------------------
pub struct SpikeEvent {
    pub source_neuron_id: u32,
    pub target_neuron_id: u32,
    pub timestamp_us: u64,           // Microsecond event timestamp
    pub synaptic_weight: f64,        // Dynamic synaptic efficacy
}

// ----------------------------------------------------------------------------
// Individual Leaky Integrate-and-Fire (LIF) Neuron State
// ----------------------------------------------------------------------------
pub struct LifNeuron {
    pub id: u32,
    pub membrane_potential_mv: f64,
    pub last_spike_time_us: u64,
    pub last_update_time_us: u64,
    pub is_refractory: bool,
    pub total_spikes_emitted: u64,
}

// ----------------------------------------------------------------------------
// Synaptic Connection with Spike-Timing-Dependent Plasticity (STDP)
// ----------------------------------------------------------------------------
pub struct StdpSynapse {
    pub pre_neuron_id: u32,
    pub post_neuron_id: u32,
    pub weight: f64,                 // Current synaptic weight [0.0, 1.0]
    pub a_plus: f64,                 // Long-Term Potentiation (LTP) rate (0.01)
    pub a_minus: f64,                // Long-Term Depression (LTD) rate (0.0105)
    pub tau_plus_ms: f64,            // STDP LTP time constant (20.0 ms)
    pub tau_minus_ms: f64,           // STDP LTD time constant (20.0 ms)
}

// ----------------------------------------------------------------------------
// Neuromorphic Spiking Engine Manager
// ----------------------------------------------------------------------------
pub struct NeuromorphicEngine {
    pub params: LifNeuronParams,
    pub num_neurons: u32,
    pub total_events_processed: u64,
}

impl NeuromorphicEngine {
    // ------------------------------------------------------------------------
    // Initialize Neuromorphic SNN Engine
    // ------------------------------------------------------------------------
    pub fn new(p: LifNeuronParams, n_neurons: u32) -> NeuromorphicEngine {
        return NeuromorphicEngine {
            params: p,
            num_neurons: n_neurons,
            total_events_processed: 0,
        };
    }

    // ------------------------------------------------------------------------
    // Process Incoming Synaptic Spike and Integrate Membrane Potential
    // ODE: tau_m * dV/dt = -(V - V_rest) + R * I(t)
    // ------------------------------------------------------------------------
    pub fn process_spike(
        &mut self,
        neuron: &mut LifNeuron,
        spike: &SpikeEvent,
        current_time_us: u64
    ) -> Option<SpikeEvent> {
        self.total_events_processed += 1;

        // 1. Check Refractory Period
        let time_since_spike_ms = ((current_time_us - neuron.last_spike_time_us) as f64) / 1000.0;
        if time_since_spike_ms < self.params.refractory_period_ms {
            neuron.is_refractory = true;
            return Option::None;
        }
        neuron.is_refractory = false;

        // 2. Exponential Passive Leak Integration between Events
        let dt_ms = ((current_time_us - neuron.last_update_time_us) as f64) / 1000.0;
        let decay = math::exp(-dt_ms / self.params.membrane_time_constant_ms);
        neuron.membrane_potential_mv = self.params.resting_potential_mv + 
            ((neuron.membrane_potential_mv - self.params.resting_potential_mv) * decay);
        neuron.last_update_time_us = current_time_us;

        // 3. Post-Synaptic Current (PSC) Influx
        neuron.membrane_potential_mv += spike.synaptic_weight * 3.5; // Excitatory Post-Synaptic Potential (EPSP)

        // 4. Threshold Action Potential Trigger Check
        if neuron.membrane_potential_mv >= self.params.threshold_potential_mv {
            // Emit Action Potential Spike
            neuron.membrane_potential_mv = self.params.reset_potential_mv;
            neuron.last_spike_time_us = current_time_us;
            neuron.total_spikes_emitted += 1;

            return Option::Some(SpikeEvent {
                source_neuron_id: neuron.id,
                target_neuron_id: 0, // Broadcast to downstream fanout
                timestamp_us: current_time_us,
                synaptic_weight: 1.0,
            });
        }

        return Option::None;
    }

    // ------------------------------------------------------------------------
    // Update Synaptic Plasticity via Hebbian STDP Learning Rule
    // ------------------------------------------------------------------------
    pub fn update_stdp(synapse: &mut StdpSynapse, delta_t_ms: f64) {
        if delta_t_ms > 0.0 {
            // Pre fired before Post: Long-Term Potentiation (LTP)
            let dw = synapse.a_plus * math::exp(-delta_t_ms / synapse.tau_plus_ms);
            synapse.weight += dw;
            if synapse.weight > 1.0 { synapse.weight = 1.0; }
        } else {
            // Post fired before Pre: Long-Term Depression (LTD)
            let dw = synapse.a_minus * math::exp(delta_t_ms / synapse.tau_minus_ms);
            synapse.weight -= dw;
            if synapse.weight < 0.0 { synapse.weight = 0.0; }
        }
    }
}
