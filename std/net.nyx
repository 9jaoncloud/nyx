module net

extern "C" {
    fn nyx_socket(domain: i32, type_: i32, protocol: i32) -> i32
    fn nyx_bind(sock: i32, addr: *const u8, port: i32) -> i32
    fn nyx_listen(sock: i32, backlog: i32) -> i32
    fn nyx_accept(sock: i32) -> i32
    fn nyx_connect(host: *const u8, port: i32) -> i32
    fn nyx_send(sock: i32, data: *const u8, len: u64) -> i64
    fn nyx_recv(sock: i32, buf: *mut u8, len: u64) -> i64
    fn nyx_close(sock: i32)
    fn nyx_set_nonblocking(sock: i32, enable: i32)
    fn nyx_set_timeout(sock: i32, seconds: i32)
    fn nyx_udp_socket(domain: i32) -> i32
    fn nyx_udp_sendto(sock: i32, data: *const u8, len: u64, addr: *const u8, port: i32) -> i64
    fn nyx_udp_recvfrom(sock: i32, buf: *mut u8, len: u64, addr: *mut u8, port: *mut i32) -> i64
    fn nyx_tls_connect(host: *const u8, port: i32) -> i32
    fn nyx_tls_send(sock: i32, data: *const u8, len: u64) -> i64
    fn nyx_tls_recv(sock: i32, buf: *mut u8, len: u64) -> i64
    fn nyx_tls_close(sock: i32)
    fn nyx_https_fetch_raw(method: *const u8, url: *const u8, headers: *const u8, body: *const u8, body_len: u64, resp_buf: *mut u8, max_resp_len: u64, status_out: *mut i32) -> i64

    /* WebSocket (RFC 6455) handshake + real peer address helpers (runtime/rt_ws.h, rt_net.h) */
    fn nyx_peer_addr(sock: i32, buf: *mut u8, buflen: i32) -> i32
    fn nyx_ws_client_key(out: *mut u8)
    fn nyx_ws_accept_key(client_key: *const u8, out: *mut u8)
    fn nyx_random_bytes(buf: *mut u8, len: u64)
    fn rt_string_from(s: *const u8) -> String
    fn rt_string_from_len(p: *const u8, len: i64) -> String
    fn nyx_ws_handshake(sock: i32, host: *const u8, hlen: i32, port: i32, path: *const u8, plen: i32) -> i32
    fn nyx_ws_send(sock: i32, opcode: i32, data: *const u8, len: i64) -> i64
    fn nyx_ws_recv(sock: i32, out: *mut u8, max: i32, opcode: *mut i32, fin: *mut i32) -> i64
}

/* ── TCP ──────────────────────────────────────────────────────── */

pub struct TcpListener {
    sock: i32,
    host: String,
    port: i32,
}

pub struct TcpStream {
    sock: i32,
    read_timeout: i32,
    write_timeout: i32,
}

impl TcpListener {
    pub fn bind(addr: String, port: i32) -> Result<TcpListener, String> {
        let sock = nyx_socket(2, 1, 0)
        if sock < 0 {
            return Result.Err("Socket creation failed".to_string())
        }
        if nyx_bind(sock, addr.as_ptr(), port) < 0 {
            nyx_close(sock)
            return Result.Err("Bind failed on " + addr + ":" + port.to_string())
        }
        if nyx_listen(sock, 128) < 0 {
            nyx_close(sock)
            return Result.Err("Listen failed".to_string())
        }
        Result.Ok(TcpListener { sock, host: addr, port })
    }

    pub fn local_addr(self: &TcpListener) -> String {
        self.host.clone() + ":" + self.port.to_string()
    }

    pub fn accept(self: &TcpListener) -> Result<TcpStream, String> {
        let client = nyx_accept(self.sock)
        if client < 0 {
            return Result.Err("Accept failed".to_string())
        }
        Result.Ok(TcpStream { sock: client, read_timeout: 0, write_timeout: 0 })
    }

    pub fn set_nonblocking(self: &TcpListener, enable: Bool) {
        nyx_set_nonblocking(self.sock, if enable { 1 } else { 0 })
    }

    pub fn close(self: &TcpListener) {
        nyx_close(self.sock)
    }
}

impl TcpStream {
    pub fn connect(host: String, port: i32) -> Result<TcpStream, String> {
        let sock = nyx_connect(host.as_ptr(), port)
        if sock < 0 {
            return Result.Err("Connection failed to " + host + ":" + port.to_string())
        }
        Result.Ok(TcpStream { sock, read_timeout: 0, write_timeout: 0 })
    }

    pub fn read(self: &TcpStream, max_len: u64) -> Result<Vec<u8>, String> {
        let mut buf = [0u8; 65536]
        let to_read = if max_len > 65536 { 65536 } else { max_len }
        let n = nyx_recv(self.sock, &mut buf[0], to_read)
        if n < 0 {
            return Result.Err("Read failed".to_string())
        }
        let s: String = rt_string_from_len(&mut buf[0], n)
        let out: Vec<u8> = s.bytes()
        Result.Ok(out)
    }

    pub fn read_to_string(self: &TcpStream) -> Result<String, String> {
        let mut acc: String = "".to_string()
        loop {
            let chunk: Vec<u8> = self.read(65536)?
            if chunk.len() == 0 {
                break
            }
            acc = acc + String.from_utf8(chunk)
        }
        Result.Ok(acc)
    }

    pub fn read_exact(self: &TcpStream, n: u64) -> Result<Vec<u8>, String> {
        let mut buf = [0u8; 65536]
        let mut total = 0_u64
        while total < n {
            let to_read = if n - total > 65536 { 65536 } else { n - total }
            let r = nyx_recv(self.sock, &mut buf[total as usize], to_read)
            if r <= 0 { return Result.Err("Read failed".to_string()) }
            total = total + r as u64
        }
        let s: String = rt_string_from_len(&mut buf[0], total as i64)
        let out: Vec<u8> = s.bytes()
        Result.Ok(out)
    }

    pub fn write(self: &TcpStream, data: String) -> Result<(), String> {
        let n = nyx_send(self.sock, data.as_ptr(), data.len() as u64)
        if n < 0 {
            return Result.Err("Write failed".to_string())
        }
        Result.Ok(())
    }

    pub fn write_all(self: &TcpStream, data: String) -> Result<(), String> {
        let mut total = 0_u64
        let len = data.len() as u64
        while total < len {
            let remaining = data.slice(total as u64, len as u64)
            let n = nyx_send(self.sock, remaining.as_ptr(), remaining.len() as u64)
            if n <= 0 { return Result.Err("Write failed".to_string()) }
            total = total + n as u64
        }
        Result.Ok(())
    }

    pub fn write_bytes(self: &TcpStream, data: Vec<u8>) -> Result<(), String> {
        let n = nyx_send(self.sock, data.as_ptr(), data.len() as u64)
        if n < 0 {
            return Result.Err("Write failed".to_string())
        }
        Result.Ok(())
    }

    pub fn set_read_timeout(self: &mut TcpStream, seconds: i32) {
        self.read_timeout = seconds
        nyx_set_timeout(self.sock, seconds)
    }

    pub fn set_write_timeout(self: &mut TcpStream, seconds: i32) {
        self.write_timeout = seconds
        nyx_set_timeout(self.sock, seconds)
    }

    pub fn set_nonblocking(self: &TcpStream, enable: Bool) {
        nyx_set_nonblocking(self.sock, if enable { 1 } else { 0 })
    }

    pub fn peer_addr(self: &TcpStream) -> Result<String, String> {
        let mut buf = [0u8; 64]
        let port = nyx_peer_addr(self.sock, &mut buf[0], 64)
        if port < 0 {
            return Result.Err("getpeername failed".to_string())
        }
        let ip: String = rt_string_from(&mut buf[0])
        Result.Ok(ip + ":" + port.to_string())
    }

    pub fn shutdown(self: &TcpStream) -> Result<(), String> {
        nyx_close(self.sock)
        Result.Ok(())
    }

    pub fn close(self: &TcpStream) {
        nyx_close(self.sock)
    }
}

/* ── TLS / SSL Stream ─────────────────────────────────────────── */

pub struct TlsStream {
    sock: i32,
}

impl TlsStream {
    pub fn connect(host: String, port: i32) -> Result<TlsStream, String> {
        let sock = nyx_tls_connect(host.as_ptr(), port)
        if sock < 0 {
            return Result.Err("TLS connection failed to " + host + ":" + port.to_string())
        }
        Result.Ok(TlsStream { sock })
    }

    pub fn read(self: &TlsStream, max_len: u64) -> Result<Vec<u8>, String> {
        let mut buf = [0u8; 65536]
        let to_read = if max_len > 65536 { 65536 } else { max_len }
        let n = nyx_tls_recv(self.sock, &mut buf[0], to_read)
        if n < 0 {
            return Result.Err("TLS read failed".to_string())
        }
        let s: String = rt_string_from_len(&mut buf[0], n)
        let out: Vec<u8> = s.bytes()
        Result.Ok(out)
    }

    pub fn read_to_string(self: &TlsStream) -> Result<String, String> {
        let mut acc: String = "".to_string()
        loop {
            let chunk: Vec<u8> = self.read(65536)?
            if chunk.len() == 0 {
                break
            }
            acc = acc + String.from_utf8(chunk)
        }
        Result.Ok(acc)
    }

    pub fn write(self: &TlsStream, data: String) -> Result<(), String> {
        let n = nyx_tls_send(self.sock, data.as_ptr(), data.len() as u64)
        if n < 0 {
            return Result.Err("TLS write failed".to_string())
        }
        Result.Ok(())
    }

    pub fn write_all(self: &TlsStream, data: String) -> Result<(), String> {
        let mut total = 0_u64
        let len = data.len() as u64
        while total < len {
            let remaining = data.slice(total as u64, len as u64)
            let n = nyx_tls_send(self.sock, remaining.as_ptr(), remaining.len() as u64)
            if n <= 0 { return Result.Err("TLS write failed".to_string()) }
            total = total + n as u64
        }
        Result.Ok(())
    }

    pub fn close(self: &TlsStream) {
        nyx_tls_close(self.sock)
    }
}

/* ── UDP ──────────────────────────────────────────────────────── */

pub struct UdpSocket {
    sock: i32,
}

pub struct UdpPacket {
    pub data: Vec<u8>,
    pub addr: String,
    pub port: i32,
}

impl UdpSocket {
    pub fn bind(addr: String, port: i32) -> Result<UdpSocket, String> {
        let sock = nyx_udp_socket(2)
        if sock < 0 {
            return Result.Err("UDP socket creation failed".to_string())
        }
        if nyx_bind(sock, addr.as_ptr(), port) < 0 {
            nyx_close(sock)
            return Result.Err("UDP bind failed".to_string())
        }
        Result.Ok(UdpSocket { sock })
    }

    pub fn send_to(self: &UdpSocket, data: Vec<u8>, addr: String, port: i32) -> Result<usize, String> {
        let n = nyx_udp_sendto(self.sock, data.as_ptr(), data.len() as u64, addr.as_ptr(), port)
        if n < 0 {
            return Result.Err("UDP send failed".to_string())
        }
        Result.Ok(n as usize)
    }

    pub fn recv_from(self: &UdpSocket, max_len: usize) -> Result<UdpPacket, String> {
        let mut buf = [0u8; 65536]
        let mut addr_buf = [0u8; 256]
        let mut port: i32 = 0
        let n = nyx_udp_recvfrom(self.sock, &mut buf[0], max_len as u64, &mut addr_buf[0], &mut port)
        if n < 0 {
            return Result.Err("UDP recv failed".to_string())
        }
        let mut data: Vec<u8> = Vec.new()
        for i in 0..n as usize { data.push(buf[i]) }
        let addr = String.from_utf8_bytes(addr_buf)
        Result.Ok(UdpPacket { data, addr, port })
    }

    pub fn set_nonblocking(self: &UdpSocket, enable: Bool) {
        nyx_set_nonblocking(self.sock, if enable { 1 } else { 0 })
    }

    pub fn set_timeout(self: &UdpSocket, seconds: i32) {
        nyx_set_timeout(self.sock, seconds)
    }

    pub fn close(self: &UdpSocket) {
        nyx_close(self.sock)
    }
}

/* ── WebSocket ────────────────────────────────────────────────── */

pub struct WebSocket {
    stream: TcpStream,
    connected: Bool,
    key: String,
}

pub struct WebSocketMessage {
    pub opcode: u8,
    pub payload: Vec<u8>,
    pub fin: Bool,
}

impl WebSocket {
    pub fn connect(url: String) -> Result<WebSocket, String> {
        let parts: Vec<String> = url.split("://".to_string())
        let after: String = if parts.len() > 1 { parts[1].clone() } else { parts[0].clone() }
        let slash: Vec<String> = after.split("/".to_string())
        let host_port: String = slash[0].clone()
        let mut path: String = "/".to_string()
        let mut si = 1
        while si < slash.len() {
            path = path + slash[si].clone()
            if si + 1 < slash.len() {
                path = path + "/"
            }
            si = si + 1
        }
        let hp: Vec<String> = host_port.split(":".to_string())
        let host: String = hp[0].clone()
        let port: i32 = if hp.len() > 1 { hp[1].parse_int() } else { 80 }

        let mut stream: TcpStream = TcpStream.connect(host.clone(), port)?

        let ok = nyx_ws_handshake(stream.sock, host.as_ptr(), host.len() as i32, port, path.as_ptr(), path.len() as i32)
        if ok != 0 {
            return Result.Err("WebSocket handshake failed for " + url)
        }
        Result.Ok(WebSocket { stream, connected: true, key: "".to_string() })
    }

    pub fn send_text(self: &mut WebSocket, data: String) -> Result<(), String> {
        if !self.connected { return Result.Err("Not connected".to_string()) }
        let r = nyx_ws_send(self.stream.sock, 1, data.as_ptr(), data.len() as i64)
        if r < 0 { return Result.Err("WebSocket send failed".to_string()) }
        Result.Ok(())
    }

    pub fn send_binary(self: &mut WebSocket, data: Vec<u8>) -> Result<(), String> {
        if !self.connected { return Result.Err("Not connected".to_string()) }
        let r = nyx_ws_send(self.stream.sock, 2, data.as_ptr(), data.len() as i64)
        if r < 0 { return Result.Err("WebSocket send failed".to_string()) }
        Result.Ok(())
    }

    pub fn send_ping(self: &mut WebSocket) -> Result<(), String> {
        let empty: String = "".to_string()
        let r = nyx_ws_send(self.stream.sock, 9, empty.as_ptr(), 0)
        if r < 0 { return Result.Err("WebSocket ping failed".to_string()) }
        Result.Ok(())
    }

    pub fn send_close(self: &mut WebSocket) -> Result<(), String> {
        let empty: String = "".to_string()
        let r = nyx_ws_send(self.stream.sock, 8, empty.as_ptr(), 0)
        self.connected = false
        if r < 0 { return Result.Err("WebSocket close failed".to_string()) }
        Result.Ok(())
    }

    pub fn recv(self: &mut WebSocket) -> Result<WebSocketMessage, String> {
        if !self.connected { return Result.Err("Not connected".to_string()) }
        let mut out = [0u8; 65536]
        let mut op: i32 = 0
        let mut finflag: i32 = 0
        let n = nyx_ws_recv(self.stream.sock, &mut out[0], 65536, &mut op, &mut finflag)
        if n < 0 {
            return Result.Err("WebSocket recv failed".to_string())
        }
        let payload_str: String = rt_string_from_len(&mut out[0], n)
        let payload_bytes: Vec<u8> = payload_str.bytes()
        if op == 8 { self.connected = false }
        Result.Ok(WebSocketMessage { opcode: op as u8, payload: payload_bytes, fin: finflag != 0 })
    }

    pub fn is_connected(self: &WebSocket) -> Bool {
        self.connected
    }

    pub fn close(self: &mut WebSocket) {
        let _ = self.send_close()
        self.stream.close()
    }
}

/* ── HTTP helpers (on top of TCP) ─────────────────────────────── */

pub struct NetHttpRequest {
    pub method: String,
    pub path: String,
    pub headers: Vec<(String, String)>,
    pub body: String,
}

pub struct NetHttpResponse {
    pub status: i32,
    pub headers: Vec<(String, String)>,
    pub body: String,
}

impl NetHttpRequest {
    pub fn get(url: String) -> Result<NetHttpRequest, String> {
        Result.Ok(NetHttpRequest {
            method: "GET".to_string(),
            path: url,
            headers: Vec.new(),
            body: String.new(),
        })
    }

    pub fn post(url: String, body: String) -> Result<NetHttpRequest, String> {
        Result.Ok(NetHttpRequest {
            method: "POST".to_string(),
            path: url,
            headers: Vec.new(),
            body,
        })
    }

    pub fn with_header(self: &mut NetHttpRequest, key: String, value: String) {
        self.headers.push((key, value))
    }
}

pub fn http_send(req: NetHttpRequest) -> Result<NetHttpResponse, String> {
    let scheme: Vec<String> = req.path.split("://".to_string())
    let after: String = if scheme.len() > 1 { scheme[1].clone() } else { scheme[0].clone() }
    let slash: Vec<String> = after.split("/".to_string())
    let host_port: String = slash[0].clone()
    let mut req_path: String = "/".to_string()
    let mut si = 1
    while si < slash.len() {
        req_path = req_path + slash[si].clone()
        if si + 1 < slash.len() {
            req_path = req_path + "/"
        }
        si = si + 1
    }
    let hp: Vec<String> = host_port.split(":".to_string())
    let host: String = hp[0].clone()
    let port: i32 = if hp.len() > 1 { hp[1].parse_int() } else { 80 }

    let mut stream: TcpStream = TcpStream.connect(host.clone(), port)?
    let mut request_line = req.method + " " + req_path + " HTTP/1.1\r\n"
    request_line = request_line + "Host: " + host_port + "\r\n"
    for (k, v) in req.headers {
        request_line = request_line + k + ": " + v + "\r\n"
    }
    request_line = request_line + "Connection: close\r\n"
    if req.body.len() > 0 {
        request_line = request_line + "Content-Length: " + req.body.len().to_string() + "\r\n"
    }
    request_line = request_line + "\r\n"
    if req.body.len() > 0 {
        request_line = request_line + req.body
    }
    stream.write_all(request_line)?

    let response: String = stream.read_to_string()?
    let lines: Vec<String> = response.split("\r\n".to_string())
    let mut status: i32 = 0
    let mut headers: Vec<(String, String)> = Vec.new()
    let mut body: String = "".to_string()
    if lines.len() > 0 {
        let sp: Vec<String> = lines[0].clone().split(" ".to_string())
        if sp.len() > 1 {
            status = sp[1].parse_int()
        }
    }
    let mut i = 1
    let mut in_body = false
    while i < lines.len() {
        let line: String = lines[i].clone()
        if in_body {
            if body.len() > 0 {
                body = body + "\r\n"
            }
            body = body + line
        } else if line.len() == 0 {
            in_body = true
        } else {
            let kv: Vec<String> = line.split(":".to_string())
            if kv.len() > 1 {
                let k: String = kv[0].clone()
                let mut v: String = kv[1].clone()
                let mut j = 2
                while j < kv.len() {
                    v = v + ":" + kv[j].clone()
                    j = j + 1
                }
                headers.push((k, v))
            }
        }
        i = i + 1
    }
    Result.Ok(NetHttpResponse { status, headers, body })
}

pub fn https_get(url: String) -> Result<NetHttpResponse, String> {
    let mut resp_buf = [0u8; 65536]
    let mut status_code: i32 = 0
    let method = "GET".to_string()
    let headers = "".to_string()
    let body = "".to_string()
    let n = nyx_https_fetch_raw(method.as_ptr(), url.as_ptr(), headers.as_ptr(), body.as_ptr(), 0 as u64, &mut resp_buf[0], 65536 as u64, &mut status_code)
    if n < 0 {
        return Result.Err("HTTPS request failed for " + url)
    }
    let mut resp_bytes: Vec<u8> = Vec.new()
    for i in 0..n as u64 {
        resp_bytes.push(resp_buf[i])
    }
    Result.Ok(NetHttpResponse {
        status: status_code,
        headers: Vec.new(),
        body: String.from_utf8(resp_bytes),
    })
}

/* ── Dial / Serve helpers ─────────────────────────────────────── */

pub fn dial(host: String, port: i32) -> Result<TcpStream, String> {
    TcpStream.connect(host, port)
}

pub fn tcp_serve(host: String, port: i32, handler: fn(TcpStream)) {
    let listener = TcpListener.bind(host.clone(), port)
    match listener {
        Result.Ok(ln) => {
            println("Listening on " + ln.local_addr())
            loop {
                match ln.accept() {
                    Result.Ok(stream) => { let st: TcpStream = stream; handler(st) },
                    Result.Err(e) => eprintln("Accept error: " + e),
                }
            }
        }
        Result.Err(e) => eprintln("Failed to bind: " + e),
    }
}

pub fn udp_serve(host: String, port: i32, handler: fn(UdpPacket)) {
    let socket = UdpSocket.bind(host.clone(), port)
    match socket {
        Result.Ok(sock) => {
            println("UDP listening on " + host + ":" + port.to_string())
            loop {
                match sock.recv_from(65536) {
                    Result.Ok(packet) => { let pk: UdpPacket = packet; handler(pk) },
                    Result.Err(e) => eprintln("UDP recv error: " + e),
                }
            }
        }
        Result.Err(e) => eprintln("Failed to bind UDP: " + e),
    }
}
