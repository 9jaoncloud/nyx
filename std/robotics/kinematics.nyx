module kinematics

import std.io
import std.string
import std.vec
import std.math

pub struct DhJoint {
    pub a: f64,
    pub alpha: f64,
    pub d: f64,
    pub theta: f64,
}

pub struct RobotArm {
    pub name: String,
    pub dof: i32,
    pub joints_count: i32,
    pub end_effector_x: f64,
    pub end_effector_y: f64,
    pub end_effector_z: f64,
}

pub fn create_robot_arm(name: String, dof: i32) -> RobotArm {
    RobotArm {
        name: name,
        dof: dof,
        joints_count: 0,
        end_effector_x: 0.0,
        end_effector_y: 0.0,
        end_effector_z: 0.0,
    }
}

pub fn add_joint(arm: &mut RobotArm, a: f64, alpha: f64, d: f64, theta: f64) {
    arm.joints_count = arm.joints_count + 1
    let ct = std.math.cos(theta)
    let st = std.math.sin(theta)
    arm.end_effector_x = arm.end_effector_x + (a * ct)
    arm.end_effector_y = arm.end_effector_y + (a * st)
    arm.end_effector_z = arm.end_effector_z + d
}

pub struct PidController {
    pub kp: f64,
    pub ki: f64,
    pub kd: f64,
    pub integral: f64,
    pub prev_error: f64,
    pub max_output: f64,
}

pub fn create_pid(kp: f64, ki: f64, kd: f64, max_output: f64) -> PidController {
    PidController {
        kp: kp,
        ki: ki,
        kd: kd,
        integral: 0.0,
        prev_error: 0.0,
        max_output: max_output,
    }
}

pub fn update_pid(pid: &mut PidController, setpoint: f64, measured: f64, dt: f64) -> f64 {
    let error: f64 = setpoint - measured
    pid.integral = pid.integral + (error * dt)
    let derivative: f64 = (error - pid.prev_error) / dt
    pid.prev_error = error
    let output: f64 = (pid.kp * error) + (pid.ki * pid.integral) + (pid.kd * derivative)
    if output > pid.max_output { pid.max_output }
    else if output < (0.0 - pid.max_output) { 0.0 - pid.max_output }
    else { output }
}

pub fn evaluate_quintic_trajectory(t: f64, total_duration: f64, q0: f64, q1: f64) -> f64 {
    let tau: f64 = t / total_duration
    let s: f64 = if tau > 1.0 { 1.0 } else if tau < 0.0 { 0.0 } else { tau }
    let s3: f64 = s * s * s
    let s4: f64 = s3 * s
    let s5: f64 = s4 * s
    let blend: f64 = (10.0 * s3) - (15.0 * s4) + (6.0 * s5)
    q0 + ((q1 - q0) * blend)
}
