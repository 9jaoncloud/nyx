module env

extern "C" {
    fn getenv(name: *const u8) -> *const u8
    fn setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32
    fn nyx_get_argc() -> i32
    fn nyx_get_argv(idx: i32) -> *const u8
}

pub fn args() -> Vec<String> {
    let count = nyx_get_argc()
    let mut result = Vec.new()
    for i in 0..count {
        let ptr = nyx_get_argv(i)
        if ptr != null {
            result.push(ptr.to_string())
        }
    }
    result
}

pub fn get_var(name: String) -> Option<String> {
    let ptr = getenv(name.as_ptr())
    if ptr == null { return Option.None }
    Option.Some(ptr.to_string())
}

pub fn set_var(name: String, value: String) {
    setenv(name.as_ptr(), value.as_ptr(), 1)
}

pub fn current_dir() -> String {
    let mut buf = [0u8; 4096]
    extern "C" {
        fn getcwd(buf: *mut u8, size: u64) -> *const u8
    }
    let ptr = getcwd(&mut buf[0], 4096)
    if ptr != null { ptr.to_string() } else { ".".to_string() }
}

pub fn set_current_dir(path: String) -> Result<(), String> {
    extern "C" {
        fn chdir(path: *const u8) -> i32
    }
    if chdir(path.as_ptr()) == 0 { Result.Ok(()) }
    else { Result.Err("Cannot chdir to " + path) }
}
