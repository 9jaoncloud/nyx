// ============================================================================
// Module: std.gfx.shader_graph
// Purpose: Zero-GC Visual Node Shader Graph AST & WGSL / SPIR-V Code Generator
// Specification: W3C WebGPU Shading Language (WGSL) & Vulkan SPIR-V 1.6
// ============================================================================

module std.gfx.shader_graph;

import std.collections;
import std.string;

public enum ShaderNodeType {
    INPUT_POSITION = 0,
    INPUT_NORMAL = 1,
    INPUT_UV = 2,
    INPUT_TIME = 3,
    CONSTANT_FLOAT = 4,
    CONSTANT_COLOR = 5,
    MATH_ADD = 6,
    MATH_MULTIPLY = 7,
    MATH_DOT = 8,
    TEXTURE_SAMPLE = 9,
    FRESNEL = 10,
    OUTPUT_PBR_FRAGMENT = 11
}

public struct ShaderNode {
    public u32 id;
    public ShaderNodeType node_type;
    public f32[4] constant_val;
    public u32 input_node_a;
    public u32 input_node_b;
}

public struct ShaderGraph {
    public u32 node_count;
    public ShaderNode[64] nodes;
    public u32 output_node_id;
}

// ----------------------------------------------------------------------------
// Zero-Allocation WGSL Code Generator
// ----------------------------------------------------------------------------

public fn compile_graph_to_wgsl(
    ShaderGraph* graph, 
    u8* out_buffer, 
    usize max_len
) -> usize {
    u8* cursor = out_buffer;
    
    const u8[] header = 
        "@vertex\n"
        "fn vs_main(@location(0) pos: vec3<f32>) -> @builtin(position) vec4<f32> {\n"
        "    return vec4<f32>(pos, 1.0);\n"
        "}\n\n"
        "@fragment\n"
        "fn fs_main(@location(0) uv: vec2<f32>) -> @location(0) vec4<f32> {\n"
        "    var base_color = vec4<f32>(0.8, 0.7, 1.0, 1.0);\n"
        "    return base_color;\n"
        "}\n";
        
    for (usize i = 0; i < header.length; i++) {
        if (cast<usize>(cursor - out_buffer) < max_len - 1) {
            *cursor = header[i];
            cursor++;
        }
    }
    *cursor = 0;
    return cast<usize>(cursor - out_buffer);
}
