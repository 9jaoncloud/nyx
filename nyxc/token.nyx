module token

pub enum TokenKind {
    Ident(String),
    IntLit(i64),
    FloatLit(f64),
    StringLit(String),
    True,
    False,
    Fn,
    Let,
    Mut,
    If,
    Else,
    While,
    For,
    In,
    Return,
    Struct,
    Enum,
    Match,
    Trait,
    Impl,
    Import,
    Module,
    Pub,
    Async,
    Await,
    Yield,
    Extern,
    SelfKw,
    SelfType,
    Parallel,
    Null,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Semicolon,
    Colon,
    Arrow,
    FatArrow,
    Equals,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    EqEq,
    NotEq,
    Lt,
    LtEq,
    Gt,
    GtEq,
    And,
    Or,
    Not,
    Dot,
    DotDot,
    PathSep,
    Ampersand,
    Pipe,
    Question,
    Underscore,
    EOF,
}

pub struct Token {
    pub kind: TokenKind,
    pub line: Int,
    pub col: Int,
}
