module resolver_pkg

import std.io
import std.string
import manifest
import lockfile

pub struct ResolvedPackage {
    pub name: String,
    pub version: String,
    pub url: String,
}

pub struct Resolver {
    pub registry_url: String,
    pub resolved: Vec<ResolvedPackage>,
    pub errors: Vec<String>,
}

pub fn new_resolver() -> Resolver {
    Resolver {
        registry_url: "https://packages.nyx-lang.org".to_string(),
        resolved: Vec.new(),
        errors: Vec.new(),
    }
}

impl Resolver {
    pub fn resolve_manifest(self: &mut Resolver, pkg: &manifest.Manifest, lock: &lockfile.Lockfile) -> Result<Vec<ResolvedPackage>, String> {
        self.resolved.clear()
        self.errors.clear()

        let mut all_deps = Map.new()
        for (name, version) in pkg.dependencies.iter() {
            all_deps.insert(name.clone(), version.clone())
        }
        for (name, version) in pkg.dev_dependencies.iter() {
            all_deps.insert(name.clone(), version.clone())
        }

        let mut visited = Map.new()
        for (name, version) in all_deps.iter() {
            self.resolve_package(name, version, lock, &mut visited)?
        }

        Result.Ok(self.resolved.clone())
    }

    fn resolve_package(self: &mut Resolver, name: &String, version_req: &String, lock: &lockfile.Lockfile, visited: &mut Map<String, bool>) -> Result<(), String> {
        if visited.contains_key(name) {
            return Result.Ok(())
        }
        visited.insert(name.clone(), true)

        if let Some(entry) = lockfile.find(lock, name) {
            if self.satisfies_version(&entry.version, version_req) {
                self.resolved.push(ResolvedPackage {
                    name: name.clone(),
                    version: entry.version.clone(),
                    url: entry.url.clone(),
                })
                return Result.Ok(())
            }
        }

        let resolved_version = self.resolve_version_from_registry(name, version_req)?

        self.resolved.push(ResolvedPackage {
            name: name.clone(),
            version: resolved_version.clone(),
            url: self.registry_url + "/packages/" + name + "/" + resolved_version + ".tar.gz",
        })

        Result.Ok(())
    }

    fn resolve_version_from_registry(self: &Resolver, name: &String, version_req: &String) -> Result<String, String> {
        let url = self.registry_url + "/api/packages/" + name + "/versions"
        std.io.println("  Fetching versions for " + name + " from registry...")

        let client = http.new_client()
        let response = match client.get(url) {
            Result.Ok(r) => r,
            Result.Err(_) => {
                return Result.Err("Failed to fetch package info from registry: " + name)
            }
        }

        if response.status_code == 404 {
            return Result.Err("Package not found in registry: " + name)
        }

        if response.status_code != 200 {
            return Result.Err("Registry error for " + name + ": HTTP " + response.status_code.to_string())
        }

        let versions = self.parse_version_list(&response.body)
        let best = self.pick_best_version(&versions, version_req)?

        Result.Ok(best)
    }

    fn parse_version_list(self: &Resolver, body: &String) -> Vec<String> {
        let mut versions = Vec.new()
        let content = body.trim()

        if content.starts_with("[") {
            let inner = content.substring(1, content.len() - 1)
            let parts = inner.split(",")
            for part in parts {
                let trimmed = part.trim().trim_matches('"')
                if trimmed != "" {
                    versions.push(trimmed.to_string())
                }
            }
        }

        versions
    }

    fn pick_best_version(self: &Resolver, versions: &Vec<String>, version_req: &String) -> Result<String, String> {
        if versions.is_empty() {
            return Result.Err("No versions available for package")
        }

        if version_req == "*" || version_req == "latest" {
            return Result.Ok(versions.last().unwrap().clone())
        }

        let req = version_req.trim()
        if req.starts_with(">=") {
            let min = req.substring(2).trim()
            for v in versions.iter().rev() {
                if self.version_gte(v, min) {
                    return Result.Ok(v.clone())
                }
            }
            return Result.Err("No version satisfies >= " + min)
        }

        if req.starts_with("^") {
            let caret = req.substring(1).trim()
            let caret_parts: Vec<&str> = caret.split(".").collect()
            if caret_parts.len() >= 2 {
                let major = caret_parts[0]
                let minor = caret_parts[1]
                for v in versions.iter().rev() {
                    let v_parts: Vec<&str> = v.split(".").collect()
                    if v_parts.len() >= 2 && v_parts[0] == major && v_parts[1] == minor {
                        return Result.Ok(v.clone())
                    }
                }
            }
        }

        if req.starts_with("~") {
            let tilde = req.substring(1).trim()
            let tilde_parts: Vec<&str> = tilde.split(".").collect()
            if !tilde_parts.is_empty() {
                let major = tilde_parts[0]
                for v in versions.iter().rev() {
                    let v_parts: Vec<&str> = v.split(".").collect()
                    if !v_parts.is_empty() && v_parts[0] == major {
                        return Result.Ok(v.clone())
                    }
                }
            }
        }

        for v in versions.iter().rev() {
            if *v == req {
                return Result.Ok(v.clone())
            }
        }

        if !versions.is_empty() {
            return Result.Ok(versions.last().unwrap().clone())
        }

        Result.Err("No matching version found")
    }

    fn satisfies_version(self: &Resolver, actual: &String, requirement: &String) -> bool {
        if requirement == "*" || requirement == "latest" {
            return true
        }
        let req = requirement.trim()
        if req.starts_with(">=") {
            let min = req.substring(2).trim()
            return self.version_gte(actual, min)
        }
        if req.starts_with("^") {
            let caret = req.substring(1).trim()
            let caret_parts: Vec<&str> = caret.split(".").collect()
            let actual_parts: Vec<&str> = actual.split(".").collect()
            if caret_parts.len() >= 2 && actual_parts.len() >= 2 {
                return caret_parts[0] == actual_parts[0] && caret_parts[1] == actual_parts[1]
            }
        }
        *actual == req
    }

    fn version_gte(self: &Resolver, a: &String, b: &String) -> bool {
        let pa: Vec<i64> = a.split(".").map(|s| s.parse().unwrap_or(0)).collect()
        let pb: Vec<i64> = b.split(".").map(|s| s.parse().unwrap_or(0)).collect()

        let max_len = if pa.len() > pb.len() { pa.len() } else { pb.len() }
        for i in 0..max_len {
            let va = if i < pa.len() { pa[i] } else { 0 }
            let vb = if i < pb.len() { pb[i] } else { 0 }
            if va > vb { return true }
            if va < vb { return false }
        }
        true
    }
}
