// examples/android_compatibility_demo.nyx — Tri-Mode Android Capability & Execution Demo
// Demonstrates how Nyx Mobile OS accepts, installs, and runs APK and AAB packages

import std.aab
import std.mobile.android_compat
import std.mobile.installer
import std.io

fn main() {
    println("=================================================================");
    println("  📱 NYX MOBILE OS — TRI-MODE ANDROID COMPATIBILITY ENGINE");
    println("=================================================================\n");

    // ─────────────────────────────────────────────────────────────────
    // Phase 1: Ingestion & Transpilation of Android App Bundle (.aab)
    // ─────────────────────────────────────────────────────────────────
    println("[Step 1] Ingesting Android App Bundle (.aab)...");
    let aab_path = "downloads/sample_game.aab".to_string();
    let target_apk = aab.transpile_aab_to_apk(
        aab_path, 
        "arm64-v8a".to_string(), 
        "xxhdpi".to_string(), 
        "cache/sample_game_arm64.apk".to_string()
    );

    // ─────────────────────────────────────────────────────────────────
    // Phase 2: Inspection, Permission Mapping & Sandbox Installation
    // ─────────────────────────────────────────────────────────────────
    println("[Step 2] Installing Package & Sandboxing Capabilities...");
    let install_res = installer.install_package("cache/sample_game_arm64.apk".to_string(), None);

    // ─────────────────────────────────────────────────────────────────
    // Phase 3: Executing across the Three Real-World Pathways
    // ─────────────────────────────────────────────────────────────────
    let mut sandbox = AndroidAppSandbox.new(
        "com.sovereign.game".to_string(),
        "Sovereign Cyber Runner".to_string(),
        AndroidExecutionMode.AutoDetect
    );

    // Demonstration of Pathway 1: Native NDK Direct Bridge (C++/Rust/Flutter/Unity)
    println("[Step 3A] Testing Pathway 1: Native NDK Direct Bridge");
    sandbox.launch_ndk_direct("libgame_core.so".to_string());

    // Demonstration of Pathway 2: Micro-Container ART Sandbox (Full Android Framework)
    println("[Step 3B] Testing Pathway 2: Micro-Container ART Sandbox (Waydroid Model)");
    sandbox.launch_micro_container();

    // Demonstration of Pathway 3: AOT DEX-to-Native Transpiler (Zero JVM Standalone)
    println("[Step 3C] Testing Pathway 3: AOT DEX-to-Native Transpiler (LLVM Machine Code)");
    sandbox.launch_aot_transpiled();

    println("=================================================================");
    println("  🎉 ALL THREE ANDROID EXECUTION PATHWAYS VALIDATED SUCCESSFULLY!");
    println("=================================================================");
}
