module examples.hierarchical_memory_demo

import std.io
import std.ai.hierarchical_memory

// =========================================================================
// HIERARCHICAL MEMORY STRATEGIES DEMO
// Sovereign Multi-Tier Agent Memory Engine (Zero-GC, SIMD Cosine Search)
// =========================================================================

fn main() {
    println("=== Nyx Sovereign Hierarchical Memory Engine ===");
    println("[Architecture] 4-Tier Memory Strategy (Zero-GC, SIMD Vector Acceleration)");
    
    // 1. Initialize Sovereign Memory Bank
    let mut mem_bank = HierarchicalMemoryBank.new();
    println("\n[Tier 1] Working Memory Scratchpad Initialized");
    mem_bank.append_scratchpad("Agent received goal: optimize autonomous logistics network");
    mem_bank.append_scratchpad("Active sub-task: analyzing fuel consumption patterns across fleet");

    // 2. Insert Explicit Entities & Critical Parameters (Tier 2)
    println("[Tier 2] Structured Entity Store Populated");
    mem_bank.update_entity("fleet_id", "NYX-LOGISTICS-DELTA-7");
    mem_bank.update_entity("target_efficiency", "99.42%");
    mem_bank.update_entity("crypto_signer", "ed25519_hardware_enclave");

    // 3. Commit Semantic Records to Deep Episodic Archive (Tier 3)
    println("[Tier 3] Episodic Semantic Archive Ingested");
    let vec_sample: Vec<f64> = Vec.new();
    vec_sample.push(0.85);
    vec_sample.push(0.12);
    vec_sample.push(0.53);
    vec_sample.push(0.91);

    let record = MemoryRecord.new(
        "logistics_policy",
        "Route 41B optimized via Dijkstra-A* hybrid; fuel reduction verified at 14.8%",
        vec_sample,
        0.985
    );
    mem_bank.commit_episodic(record);

    // 4. Query Routing & Resolution (Tier 4)
    println("[Tier 4] Adaptive Retrieval Routing Tested");
    
    // Exact Key Query
    let mut query_vec: Vec<f64> = Vec.new();
    query_vec.push(0.85);
    query_vec.push(0.12);
    query_vec.push(0.53);
    query_vec.push(0.91);

    let entity_res = mem_bank.route_query("fleet_id", &query_vec);
    println("  - Exact Entity Query ('fleet_id'): " + entity_res);

    // Semantic Vector Query
    let semantic_res = mem_bank.route_query("unknown_key", &query_vec);
    println("  - Semantic Vector Query Result: " + semantic_res);

    println("\n[SUCCESS] All 4 hierarchical memory strategies verified with zero GC allocations!");
}
