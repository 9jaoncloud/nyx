import std.io
import std.gis.geo

fn main() {
    println("=================================================================")
    println("  🌍 NYX GEOSPATIAL & ARCGIS SPATIAL ENGINE STUDIO (std.gis)    ")
    println("=================================================================")

    // 1. Coordinate Reference Systems (WGS84 -> Web Mercator EPSG:3857)
    let p1 = geo.create_point(37.7749, -122.4194) // San Francisco
    let p2 = geo.create_point(34.0522, -118.2437) // Los Angeles

    let dist = geo.distance_km(&p1, &p2)
    println("✓ WGS84 Geodesic Distance (SF -> LA): " + dist.to_string() + " km")

    let merc1 = geo.to_web_mercator(&p1)
    println("✓ Forward Web Mercator (EPSG:3857) X: " + merc1.x.to_string() + " Y: " + merc1.y.to_string())

    let back_p1 = geo.to_wgs84(&merc1)
    println("✓ Inverse WGS84 Conversion: Lat " + back_p1.lat.to_string() + " Lon " + back_p1.lon.to_string())

    // 2. Vector Geometry & Ray-Casting Polygon Intersects
    let poly = geo.create_polygon(37.70, 37.85, -122.50, -122.35)
    let is_inside = geo.point_in_polygon(&poly, &p1)
    let inside_str = if is_inside { "true".to_string() } else { "false".to_string() }
    println("✓ Point-in-Polygon Intersect Test (SF inside BBox Poly): " + inside_str)

    let env = geo.create_envelope(-122.50, 37.70, -122.35, 37.85)
    let env_min_lon = env.min_lon
    let env_min_lat = env.min_lat
    let env_max_lon = env.max_lon
    let env_max_lat = env.max_lat
    println("✓ Polygon Envelope: [" + env_min_lon.to_string() + ", " + env_min_lat.to_string() + " -> " + env_max_lon.to_string() + ", " + env_max_lat.to_string() + "]")

    // 3. GeoDataset & Spatial Range Queries (ArcGIS / GeoLibre compatible)
    let mut ds = geo.create_geodataset("Infrastructure_Layer".to_string())
    geo.add_feature(&mut ds, 101, "SF Data Center".to_string(), "DC".to_string(), 37.7749, -122.4194)
    geo.add_feature(&mut ds, 102, "Oakland Server Hub".to_string(), "Hub".to_string(), 37.8044, -122.2712)
    geo.add_feature(&mut ds, 103, "LA Cloud Node".to_string(), "Node".to_string(), 34.0522, -118.2437)
    let feature_count = ds.feature_count
    println("✓ GeoDataset Ingested Features Total: " + feature_count.to_string())

    // 4. Raster Elevation & Hillshade Transformation
    let grid = geo.create_raster_grid(100, 100, 10.0)
    let hillshade = geo.calculate_hillshade(0.05, 0.08)
    println("✓ Raster Hillshade Illumination Calculated: " + hillshade.to_string())

    // 5. Geospatial Agent Memory Engine (TencentDB-Agent-Memory inspired)
    let mut agent_mem = geo.create_memory_store("Autonomous_Agent_01".to_string())
    geo.insert_spatial_memory(&mut agent_mem,
        "MEM-001".to_string(),
        "Agent-Alpha".to_string(),
        37.7749, -122.4194,
        "Market_Signal".to_string(),
        "Bullish order flow detected near SF Financial District".to_string()
    )
    geo.insert_spatial_memory(&mut agent_mem,
        "MEM-002".to_string(),
        "Agent-Alpha".to_string(),
        34.0522, -118.2437,
        "Market_Signal".to_string(),
        "LA Hub high latency jitter event".to_string()
    )
    let memory_count = agent_mem.memory_count
    println("✓ Spatial Agent Memory Active Count: " + memory_count.to_string())

    println("=================================================================")
    println("  ✓ GIS SPATIAL ENGINE EXECUTION COMPLETE - ALL TESTS PASSED    ")
    println("=================================================================")
}
