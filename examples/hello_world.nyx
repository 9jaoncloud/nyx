// examples/hello_world.nyx — Quickstart Hello World in Nyx v0.53.0

fn main() {
    println("==================================================");
    println("🌙 Welcome to the Nyx Programming Language (v0.53.0)!");
    println("Zero-GC Region Inference · 0.00ms Pauses · Native x86_64");
