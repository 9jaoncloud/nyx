// examples/scientific_engine.nyx — Pure-Nyx Scientific Engine + CLI runner
// Math primitives via Taylor series, in the verified compilable dialect.

fn fact(n: Int) -> Float {
    let mut r: Float = 1.0;
    let mut i: Int = 1;
    while i <= n {
        r = r * (i as Float);
        i = i + 1;
    }
    return r;
}

fn absf(x: Float) -> Float {
    if x < 0.0 { return -x; }
    return x;
}

fn powi(base: Float, exp: Int) -> Float {
    let mut r: Float = 1.0;
    let mut i: Int = 0;
    let mut neg = false;
    let mut e = exp;
    if e < 0 { neg = true; e = -e; }
    while i < e {
        r = r * base;
        i = i + 1;
    }
    if neg {
        if r == 0.0 { return 0.0; }
        return 1.0 / r;
    }
    return r;
}

fn nyx_exp(x: Float) -> Float {
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut n: Int = 1;
    while n < 40 {
        term = term * x / (n as Float);
        sum = sum + term;
        n = n + 1;
        if absf(term) < 0.000000000000001 { break; }
    }
    return sum;
}

fn nyx_sin(x: Float) -> Float {
    let mut a = x;
    while a > 3.141592653589793 { a = a - 6.283185307179586; }
    while a < -3.141592653589793 { a = a + 6.283185307179586; }
    let mut sum: Float = a;
    let mut term: Float = a;
    let mut n: Int = 1;
    while n < 40 {
        term = -term * a * a / ((2.0 * (n as Float) + 1.0) * (2.0 * (n as Float)));
        sum = sum + term;
        n = n + 1;
        if absf(term) < 0.000000000000001 { break; }
    }
    return sum;
}

fn nyx_cos(x: Float) -> Float {
    let mut a = x;
    while a > 3.141592653589793 { a = a - 6.283185307179586; }
    while a < -3.141592653589793 { a = a + 6.283185307179586; }
    let mut sum: Float = 1.0;
    let mut term: Float = 1.0;
    let mut n: Int = 1;
    while n < 40 {
        term = -term * a * a / ((2.0 * (n as Float)) * (2.0 * (n as Float) - 1.0));
        sum = sum + term;
        n = n + 1;
        if absf(term) < 0.000000000000001 { break; }
    }
    return sum;
}

fn nyx_ln(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    let mut y: Float = (x - 1.0) / (x + 1.0);
    let y2: Float = y * y;
    let mut sum: Float = 0.0;
    let mut term: Float = y;
    let mut denom: Int = 1;
    let mut n: Int = 0;
    while n < 200 {
        sum = sum + term / (denom as Float);
        term = term * y2;
        denom = denom + 2;
        n = n + 1;
        if absf(term / (denom as Float)) < 0.00000000000001 { break; }
    }
    return 2.0 * sum;
}

fn nyx_sqrt(x: Float) -> Float {
    if x <= 0.0 { return 0.0; }
    if x == 1.0 { return 1.0; }
    let mut guess: Float = x;
    let mut i: Int = 0;
    while i < 100 {
        let next: Float = (guess + x / guess) / 2.0;
        if absf(next - guess) < 0.0000000000001 { return next; }
        guess = next;
        i = i + 1;
    }
    return guess;
}

fn nyx_pow(base: Float, expo: Float) -> Float {
    if base <= 0.0 {
        let ie = expo as Int;
        if (ie as Float) == expo { return powi(base, ie); }
        return 0.0;
    }
    return nyx_exp(expo * nyx_ln(base));
}

fn nyx_tan(x: Float) -> Float {
    let c = nyx_cos(x);
    if absf(c) < 0.000000000001 { return 0.0; }
    return nyx_sin(x) / c;
}

enum SciOp {
    None,
    Add,
    Subtract,
    Multiply,
    Divide,
    Power,
}

struct SciCalc {
    display: Float,
    previous: Float,
    op: SciOp,
    input_str: String,
    entered: Bool,
}

impl SciCalc {
    fn new() -> SciCalc {
        SciCalc {
            display: 0.0,
            previous: 0.0,
            op: SciOp.None,
            input_str: "0".to_string(),
            entered: false,
        }
    }

    fn digit(self: &mut SciCalc, d: String) {
        let mut v: Float = 0.0;
        if d == "1" { v = 1.0; }
        else if d == "2" { v = 2.0; }
        else if d == "3" { v = 3.0; }
        else if d == "4" { v = 4.0; }
        else if d == "5" { v = 5.0; }
        else if d == "6" { v = 6.0; }
        else if d == "7" { v = 7.0; }
        else if d == "8" { v = 8.0; }
        else if d == "9" { v = 9.0; }

        if self.entered {
            self.display = v;
            self.input_str = d;
            self.entered = false;
        } else if self.input_str == "0" {
            self.display = v;
            self.input_str = d;
        } else {
            self.display = self.display * 10.0 + v;
            self.input_str = self.input_str + d;
        }
    }

    fn dot(self: &mut SciCalc) {
        if self.entered {
            self.input_str = "0.".to_string();
            self.entered = false;
        } else if !self.input_str.contains(".") {
            self.input_str = self.input_str + ".";
        }
    }

    fn unary(self: &mut SciCalc, kind: String) {
        let v = self.display;
        if kind == "sin" {
            self.display = nyx_sin(v);
        } else if kind == "cos" {
            self.display = nyx_cos(v);
        } else if kind == "tan" {
            self.display = nyx_tan(v);
        } else if kind == "ln" {
            self.display = nyx_ln(v);
        } else if kind == "log" {
            self.display = nyx_ln(v) / nyx_ln(10.0);
        } else if kind == "sqrt" {
            self.display = nyx_sqrt(v);
        } else if kind == "exp" {
            self.display = nyx_exp(v);
        } else if kind == "sqr" {
            self.display = v * v;
        } else if kind == "inv" {
            if v != 0.0 { self.display = 1.0 / v; } else { self.display = 0.0; }
        } else if kind == "neg" {
            self.display = -v;
        } else if kind == "fact" {
            if v >= 0.0 && v <= 170.0 {
                self.display = fact(v as Int);
            }
        }
        self.input_str = self.display.to_string();
        self.entered = true;
    }

    fn set_op(self: &mut SciCalc, o: SciOp) {
        self.previous = self.display;
        self.op = o;
        self.entered = true;
    }

    fn equals(self: &mut SciCalc) {
        let current = self.display;
        let mut res = current;
        match self.op {
            SciOp.Add => { res = self.previous + current; },
            SciOp.Subtract => { res = self.previous - current; },
            SciOp.Multiply => { res = self.previous * current; },
            SciOp.Divide => { if current != 0.0 { res = self.previous / current; } },
            SciOp.Power => { res = nyx_pow(self.previous, current); },
            SciOp.None => { res = current; },
        }
        self.display = res;
        self.input_str = res.to_string();
        self.op = SciOp.None;
        self.entered = true;
    }

    fn clear(self: &mut SciCalc) {
        self.display = 0.0;
        self.previous = 0.0;
        self.op = SciOp.None;
        self.input_str = "0".to_string();
        self.entered = false;
    }
}

fn main() -> Int {
    println("=============================================");
    println("Sci engine self-test");
    println("=============================================");
    println("sin(0) = ", nyx_sin(0.0));
    println("cos(0) = ", nyx_cos(0.0));
    println("sin(pi/2) = ", nyx_sin(1.5707963267948966));
    println("exp(1) = ", nyx_exp(1.0));
    println("sqrt(2) = ", nyx_sqrt(2.0));
    println("2^10 = ", nyx_pow(2.0, 10.0));
    println("fact(5) = ", fact(5));

    let mut c = SciCalc.new();
    c.digit("1".to_string());
    c.digit("2".to_string());
    c.set_op(SciOp.Add);
    c.digit("3".to_string());
    c.digit("0".to_string());
    c.equals();
    println("calc 12+30 = ", c.display);
    return 0;
}
